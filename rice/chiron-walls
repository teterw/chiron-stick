#!/usr/bin/env python3
"""chiron-walls: the wallpaper picker (Super+W) and the animated wallpaper changes of the Chiron
Stick desktop theme. Runs as the desktop user; the theme itself comes from chiron-rice.

  chiron-walls pick                     full-screen picker: browse with a live preview of the theme
                                        on the wallpaper, Enter applies it, Delete removes it, Esc goes back
  chiron-walls review                   every picture not yet reviewed, one at a time: Keep or Remove
  chiron-walls transition OLD NEW [FX]  animate the desktop from OLD to NEW behind the windows
                                        (FX: grow, wipe, wave, fade or random); prints "ready" once
                                        the old wallpaper covers the desktop

Everything is drawn with cairo on the CPU, so it works without a GPU driver too. Pictures load in a
background thread; the screen only redraws while something moves."""
import math
import random
import sys
import threading
import time
from collections import OrderedDict
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

try:
    import cairo
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import Gdk, GLib, Gtk, Pango, PangoCairo
    from PIL import Image, ImageFilter, ImageOps
except (ImportError, ValueError) as err:  # chiron-rice falls back to its rofi picker
    print(f"chiron-walls: can't start ({err})", file=sys.stderr)
    sys.exit(3)

RICE = Path(__file__).resolve().parent
_loader = SourceFileLoader("chiron_rice", str(RICE / "chiron-rice"))
rice = module_from_spec(spec_from_loader("chiron_rice", _loader))
_loader.exec_module(rice)

FONT, MONO = "Noto Sans", "JetBrainsMono Nerd Font"


# ---------------------------------------------------------------- animation helpers

def clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))


def ease_out(t):
    return 1 - (1 - t) ** 3


def ease_in_out(t):
    return 4 * t ** 3 if t < 0.5 else 1 - (-2 * t + 2) ** 3 / 2


def lerp(a, b, t):
    return a + (b - a) * t


def lerp_rgb(a, b, t):
    return tuple(x + (y - x) * t for x, y in zip(a, b))


def mix_theme(a, b, t):
    """Colours partway between two chiron-rice themes, for smooth recolouring."""
    out = {k: lerp_rgb(a[k], b[k], t) for k in ("bg", "fg", "accent", "on_accent", "surface", "surface2", "muted")}
    out["term"] = [lerp_rgb(x, y, t) for x, y in zip(a["term"], b["term"])]
    return out


class Tween:
    """A value going from a to b over dur seconds."""

    def __init__(self, a=0.0, b=1.0, dur=0.3, ease=ease_out):
        self.a, self.b, self.dur, self.ease, self.t0 = a, b, max(dur, 1e-6), ease, time.monotonic()

    def progress(self, now):
        return clamp((now - self.t0) / self.dur)

    def value(self, now):
        return lerp(self.a, self.b, self.ease(self.progress(now)))

    def done(self, now):
        return now - self.t0 >= self.dur


# ---------------------------------------------------------------- pictures

def surface(im):
    """PIL image -> cairo surface (cairo keeps premultiplied BGRA in memory on little-endian PCs)."""
    im = im.convert("RGBA")
    w, h = im.size
    return cairo.ImageSurface.create_for_data(bytearray(im.tobytes("raw", "BGRa")), cairo.FORMAT_ARGB32, w, h, w * 4)


def cover(path, w, h):
    """The picture as xfdesktop's "zoomed" style shows it on a w x h screen: scaled to cover, centred."""
    with Image.open(path) as im:
        im.draft("RGB", (w, h))  # JPEG: decode at a reduced size straight away
        return surface(ImageOps.fit(im.convert("RGB"), (w, h), Image.BILINEAR))


def thumb(path):
    t = rice.thumb_path(path)
    if not t.exists():
        rice.build_thumbs([path], quiet=True)  # cached for next time
    with Image.open(t if t.exists() else path) as im:
        im.draft("RGB", (320, 180))
        return surface(ImageOps.fit(im.convert("RGB"), (320, 180), Image.BILINEAR))


def blurred(path, w, h):
    """A tiny blurred copy; cairo scales it up into a soft backdrop."""
    t = rice.thumb_path(path)
    with Image.open(t if t.exists() else path) as im:
        im.draft("RGB", (320, 180))
        small = ImageOps.fit(im.convert("RGB"), (max(16, w // 14), max(9, h // 14)), Image.BILINEAR)
    return surface(small.filter(ImageFilter.GaussianBlur(2.2)))


def theme_of(path):
    try:
        return rice.derive(rice.run_wallust(path))
    except SystemExit:
        return None


def paint_scaled(cr, src, x, y, w, h, alpha=1.0, filt=cairo.FILTER_BILINEAR):
    sw, sh = src.get_width(), src.get_height()
    cr.save()
    cr.translate(x, y)
    cr.scale(w / sw, h / sh)
    cr.set_source_surface(src, 0, 0)
    cr.get_source().set_filter(filt)
    cr.get_source().set_extend(cairo.EXTEND_PAD)
    cr.paint_with_alpha(alpha)
    cr.restore()


def rrect(cr, x, y, w, h, r):
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, s, x, y, size, color, alpha=1.0, weight="", font=FONT, align="left", width=None):
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(Pango.FontDescription(f"{font} {weight} {size:.1f}px"))
    layout.set_text(s, -1)
    if width:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_ellipsize(Pango.EllipsizeMode.END)
    w, h = layout.get_pixel_size()
    if align == "center":
        x -= w / 2
    elif align == "right":
        x -= w
    cr.set_source_rgba(*color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return w, h


def pretty(path):
    """(label, title): "SPACE" / "ROSE-PINE · PHOTOGRAPHY", and the picture's title."""
    src, folder, title, _credit = rice.describe(path)
    return (f"{src} · {folder}" if folder else src), title


def contain(path, w, h):
    """The whole picture, scaled to fit inside w x h (never up). Returns (surface, original size)."""
    with Image.open(path) as im:
        size = im.size
        im.draft("RGB", (w, h))
        im = im.convert("RGB")
        im.thumbnail((w, h), Image.LANCZOS)
        return surface(im), size


# ---------------------------------------------------------------- swww-style transitions

EFFECTS = ("grow", "wipe", "wave", "fade")


class Transition:
    """The old wallpaper turns into the new one on every monitor, in windows that sit at the desktop
    layer: above xfdesktop, below everything else, like swww on Wayland."""

    def __init__(self, old, new, effect):
        self.effect = random.choices(EFFECTS, weights=(4, 3, 3, 1))[0] if effect not in EFFECTS else effect
        self.dur = 1.0 if self.effect == "fade" else 1.35
        self.angle = math.radians(random.choice((15, 165, 195, 345, 60, 240)))
        self.t0, self.announced = None, False
        display = Gdk.Display.get_default()
        try:
            _, px, py = display.get_default_seat().get_pointer().get_position()
        except Exception:  # noqa: BLE001 - no pointer: grow from the middle
            px = py = None
        self.views = []
        for i in range(display.get_n_monitors()):
            mon = display.get_monitor(i)
            g, scale = mon.get_geometry(), mon.get_scale_factor()
            old_s, new_s = cover(old, g.width * scale, g.height * scale), cover(new, g.width * scale, g.height * scale)
            for s in (old_s, new_s):
                s.set_device_scale(scale, scale)
            inside = px is not None and g.x <= px < g.x + g.width and g.y <= py < g.y + g.height
            origin = (px - g.x, py - g.y) if inside else (g.width * random.uniform(0.3, 0.7), g.height * random.uniform(0.3, 0.7))
            win = Gtk.Window()
            win.set_type_hint(Gdk.WindowTypeHint.DESKTOP)
            win.set_decorated(False)
            win.set_skip_taskbar_hint(True)
            win.set_skip_pager_hint(True)
            win.set_accept_focus(False)
            win.set_keep_below(True)
            win.set_app_paintable(True)
            win.move(g.x, g.y)
            win.set_size_request(g.width, g.height)
            view = {"win": win, "w": g.width, "h": g.height, "old": old_s, "new": new_s, "origin": origin, "drawn": False}
            win.connect("draw", self.draw, view)
            self.views.append(view)
        for v in self.views:
            v["win"].show_all()
            v["win"].stick()
        self.views[0]["win"].add_tick_callback(self.tick)
        GLib.timeout_add(8000, Gtk.main_quit)  # whatever happens, never stay on screen

    def draw(self, _widget, cr, v):
        p = 0.0 if self.t0 is None else ease_in_out(clamp((time.monotonic() - self.t0) / self.dur))
        cr.set_source_surface(v["old"], 0, 0)
        cr.paint()
        if p > 0:
            self.paint_new(cr, v, p)
        if not v["drawn"]:
            v["drawn"] = True
            if all(x["drawn"] for x in self.views) and not self.announced:
                self.announced = True
                GLib.timeout_add(60, self.announce)
        return True

    def announce(self):
        print("ready", flush=True)  # chiron-rice switches the wallpaper underneath now
        GLib.timeout_add(150, self.start)
        return False

    def start(self):
        self.t0 = time.monotonic()
        return False

    def paint_new(self, cr, v, p):
        w, h, new = v["w"], v["h"], v["new"]
        cr.save()
        if self.effect == "fade":
            cr.set_source_surface(new, 0, 0)
            cr.paint_with_alpha(p)
        elif self.effect == "grow":  # a soft-edged circle from the mouse pointer
            cx, cy = v["origin"]
            soft = 0.14 * min(w, h)
            r = p * (max(math.hypot(cx - x, cy - y) for x in (0, w) for y in (0, h)) + soft)
            mask = cairo.RadialGradient(cx, cy, max(0.0, r - soft), cx, cy, max(r, 0.01))
            mask.add_color_stop_rgba(0, 0, 0, 0, 1)
            mask.add_color_stop_rgba(1, 0, 0, 0, 0)
            cr.set_source_surface(new, 0, 0)
            cr.mask(mask)
        else:
            dx, dy = math.cos(self.angle), math.sin(self.angle)
            proj = [x * dx + y * dy for x in (0, w) for y in (0, h)]
            lo, hi = min(proj), max(proj)
            if self.effect == "wipe":  # a soft straight edge sweeping across at an angle
                soft = 0.12 * min(w, h)
                s = lo + p * (hi - lo + 2 * soft)
                mask = cairo.LinearGradient(dx * (s - soft), dy * (s - soft), dx * s, dy * s)
                mask.add_color_stop_rgba(0, 0, 0, 0, 1)
                mask.add_color_stop_rgba(1, 0, 0, 0, 0)
                cr.set_source_surface(new, 0, 0)
                cr.mask(mask)
            else:  # wave: a rippling edge sweeping across
                nx, ny = -dy, dx
                amp, lam = 0.04 * min(w, h), 0.25 * max(w, h)
                s = lo - 2 * amp + p * (hi - lo + 4 * amp)
                along = [x * nx + y * ny for x in (0, w) for y in (0, h)]
                a0, a1 = min(along) - lam, max(along) + lam
                n = 96
                for i in range(n + 1):
                    u = a0 + (a1 - a0) * i / n
                    off = s + amp * math.sin(2 * math.pi * u / lam + p * 7)
                    (cr.move_to if i == 0 else cr.line_to)(dx * off + nx * u, dy * off + ny * u)
                back = lo - 4 * amp - 10
                cr.line_to(dx * back + nx * a1, dy * back + ny * a1)
                cr.line_to(dx * back + nx * a0, dy * back + ny * a0)
                cr.close_path()
                cr.clip()
                cr.set_source_surface(new, 0, 0)
                cr.paint()
        cr.restore()

    def tick(self, _widget, _clock):
        for v in self.views:
            v["win"].queue_draw()
        if self.t0 is not None and time.monotonic() - self.t0 > self.dur + 0.4:
            Gtk.main_quit()  # xfdesktop has drawn the new wallpaper underneath by now
            return False
        return True


# ---------------------------------------------------------------- the picker

class Picker(Gtk.Window):
    """Opens by shrinking the current wallpaper into a preview card; Enter grows the chosen one back
    into the desktop (the very picture xfdesktop then shows, so the hand-over is seamless)."""

    LRU = {"card": 10, "full": 3, "blur": 12, "thumb": 160, "theme": 400}

    def __init__(self):
        super().__init__(title="Chiron wallpapers")
        st = rice.load_state()
        self.animate = st.get("animations", True)
        self.mode = st.get("mode", "personal")
        self.items = rice.wallpapers(self.mode)
        self.names = [f"{p.relative_to(rice.WALLS) if p.is_relative_to(rice.WALLS) else p.name} {pretty(p)[1]}".lower()
                      for p in self.items]
        self.view = list(range(len(self.items)))
        self.query = ""
        cur = st.get("wallpaper")
        self.current = Path(cur) if cur and Path(cur).is_file() else None
        self.sel = next((i for i, p in enumerate(self.items) if p == self.current), 0)
        self.exit_code = 1

        display = Gdk.Display.get_default()
        try:
            _, px, py = display.get_default_seat().get_pointer().get_position()
            mon = display.get_monitor_at_point(px, py)
        except Exception:  # noqa: BLE001
            mon = display.get_primary_monitor() or display.get_monitor(0)
        g = mon.get_geometry()
        self.W, self.H = g.width, g.height
        self.cw, self.ch = int(self.W * 0.56), int(self.H * 0.56)  # the card has the screen's shape
        self.cx, self.cy = (self.W - self.cw) / 2, self.H * 0.095
        self.move(g.x, g.y)
        self.set_default_size(self.W, self.H)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_app_paintable(True)
        self.set_keep_above(True)
        for i in range(display.get_n_monitors()):
            if display.get_monitor(i) == mon:
                self.fullscreen_on_monitor(self.get_screen(), i)
        self.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.KEY_RELEASE_MASK | Gdk.EventMask.SCROLL_MASK
                        | Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
        self.connect("draw", self.on_draw)
        self.connect("key-press-event", self.on_key)
        self.connect("key-release-event", self.on_key_release)
        self.connect("scroll-event", self.on_scroll)
        self.connect("button-press-event", self.on_click)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("map-event", self.on_map)
        self.connect("delete-event", lambda *a: self.quit(1))

        # caches: kind -> OrderedDict(index -> result); "cur" is the current wallpaper
        self.cache = {k: OrderedDict() for k in self.LRU}
        self.loaded_at = {}
        self.inflight, self.lock, self.wake, self.closing = set(), threading.Lock(), threading.Event(), False
        self.cur_full = cover(self.current, self.W, self.H) if self.current else None
        base = theme_of(self.current) if self.current else None
        self.theme_from = self.theme_to = base or rice.derive({"background": "#0b0a12", "foreground": "#ece9f4",
                                                              **{f"color{i}": "#8b5cf6" for i in range(16)}})
        now = time.monotonic()
        self.theme_tw = Tween(1, 1, 0.01)
        self.layers = [{"src": self.cur_full, "tw": Tween(1, 1, 0.01)}] if self.cur_full else []  # card pictures
        self.backs = []  # backdrop pictures
        self.pos = float(self.sel)
        self.phase, self.phase_tw = "open", Tween(0, 1, 0.6 if self.animate else 0.01, ease_out)
        self.mock_tw = Tween(1, 1, 0.01)
        self.apply_done = None
        # Delete removes the selected wallpaper (saved like the review; Ctrl+Z brings it back)
        self.gone, self.removed, self.dropping, self.gap = set(), [], [], None
        self.toast, self.held, self.last_remove = None, {}, 0.0
        self.remove_btn, self.hover_remove, self.current_removed = None, False, False
        self.last = now
        if self.items:
            self.select(self.sel, fade=False)
        threading.Thread(target=self.loader, daemon=True).start()
        self.add_tick_callback(self.tick)

    # ---------------------------------------------------------------- background loading

    def jobs(self):
        if not self.view:
            return []
        s = self.view[self.sel]
        near = [self.view[self.sel + d] for d in (1, -1, 2, -2) if 0 <= self.sel + d < len(self.view)]
        film = [self.view[self.sel + d] for d in range(-9, 10) if 0 <= self.sel + d < len(self.view)]
        out = [("card", s), ("theme", s), ("blur", s)] + [("thumb", i) for i in film] + [("full", s)]
        out += [(k, i) for i in near for k in ("card", "theme", "blur")]
        return out

    def next_job(self):
        with self.lock:
            for job in self.jobs():
                if job not in self.inflight and job[1] not in self.cache[job[0]]:
                    self.inflight.add(job)
                    return job
        return None

    def loader(self):
        while not self.closing:
            job = self.next_job()
            if job is None:
                self.wake.wait(0.3)
                self.wake.clear()
                continue
            kind, idx = job
            path = self.items[idx]
            try:
                res = {"card": lambda: cover(path, self.cw, self.ch), "full": lambda: cover(path, self.W, self.H),
                       "blur": lambda: blurred(path, self.W, self.H), "thumb": lambda: thumb(path),
                       "theme": lambda: theme_of(path)}[kind]()
            except Exception:  # noqa: BLE001 - an unreadable picture just stays a placeholder
                res = None
            GLib.idle_add(self.loaded, kind, idx, res)

    def loaded(self, kind, idx, res):
        with self.lock:
            self.inflight.discard((kind, idx))
            c = self.cache[kind]
            c[idx] = res
            while len(c) > self.LRU[kind]:
                c.popitem(last=False)
        self.loaded_at[(kind, idx)] = time.monotonic()
        if self.view and idx == self.view[self.sel] and res is not None:
            if kind == "card" and self.phase == "browse":
                self.push_layer(res)
            elif kind == "blur":
                self.backs.append({"src": res, "tw": Tween(0, 1, 0.45 if self.animate else 0.01)})
            elif kind == "theme":
                self.retheme(res)
        self.queue_draw()
        return False

    def get(self, kind, idx):
        c = self.cache[kind]
        if idx in c:
            c.move_to_end(idx)
            return c[idx]
        return None

    # ---------------------------------------------------------------- state changes

    def push_layer(self, src, dur=0.28):
        self.layers.append({"src": src, "tw": Tween(0, 1, dur if self.animate else 0.01)})

    def theme_now(self, now):
        return mix_theme(self.theme_from, self.theme_to, self.theme_tw.value(now))

    def retheme(self, theme):
        now = time.monotonic()
        self.theme_from, self.theme_to = self.theme_now(now), theme
        self.theme_tw = Tween(0, 1, 0.45 if self.animate else 0.01, ease_in_out)

    def select(self, sel, fade=True):
        if not self.view:
            return
        self.sel = max(0, min(len(self.view) - 1, sel))
        idx = self.view[self.sel]
        src = self.get("card", idx) or self.get("thumb", idx)
        if src is not None and fade:
            self.push_layer(src)
        th = self.get("theme", idx)
        if th:
            self.retheme(th)
        b = self.get("blur", idx)
        if b is not None:
            self.backs.append({"src": b, "tw": Tween(0, 1, 0.45 if self.animate else 0.01)})
        self.wake.set()
        self.queue_draw()

    def set_query(self, q):
        self.query = q
        toks = q.lower().split()
        keep = self.view[self.sel] if self.view else None
        self.view = [i for i, n in enumerate(self.names) if i not in self.gone and all(t in n for t in toks)]
        new = self.view.index(keep) if keep in self.view else 0
        self.pos = new - 0.6 if self.view else 0.0
        self.select(new)

    def confirm(self):
        if not self.view or self.phase != "browse":
            return
        idx = self.view[self.sel]
        path = self.items[idx]
        self.phase, self.phase_tw = "confirm", Tween(0, 1, 0.65 if self.animate else 0.01, ease_in_out)
        self.target = idx
        self.wake.set()

        def work():
            try:
                rice.apply(path, quiet=True)
                code = 0
            except (Exception, SystemExit) as e:  # noqa: BLE001
                print(f"chiron-walls: {e}", file=sys.stderr)
                code = 2
            GLib.idle_add(self.applied, code)
        threading.Thread(target=work, daemon=True).start()

    def applied(self, code):
        self.exit_code, self.apply_done = code, time.monotonic()
        return False

    def remove_selected(self):
        """Delete or the card's ✕: this wallpaper goes. Saved like a Remove in the review, so it stays
        gone after updates; the file leaves the disk when the picker closes. Ctrl+Z brings it back."""
        now = time.monotonic()
        if self.phase != "browse" or not self.view or now - self.last_remove < 0.25:
            return  # 0.25 s apart at least: a double-click removes one
        idx = self.view[self.sel]
        path = self.items[idx]
        if not path.is_relative_to(rice.WALLS):
            self.toast = ("Only downloaded wallpapers can be removed", now)
            return
        self.last_remove = now
        review = rice.load_review()
        rel = str(path.relative_to(rice.WALLS))
        was_kept = rel in review["keep"]  # Ctrl+Z puts it back exactly as it was
        review["drop"].add(rel)
        review["keep"].discard(rel)
        rice.save_review(review)
        self.removed.append((idx, was_kept))
        self.gone.add(idx)
        self.current_removed = self.current_removed or path == self.current
        src = self.get("card", idx) or self.get("thumb", idx)
        if src is not None:  # the card drops away; the next picture fades in behind it
            self.dropping.append({"src": src, "tw": Tween(0, 1, 0.5 if self.animate else 0.01, ease_in_out)})
        self.view.pop(self.sel)
        self.gap = (self.sel, Tween(1, 0, 0.3 if self.animate else 0.01))  # the filmstrip closes up
        self.layers = []
        if self.view:
            self.select(min(self.sel, len(self.view) - 1))
        self.toast = (f"Removed “{pretty(path)[1]}”   ·   Ctrl+Z to undo", now)
        self.queue_draw()

    def undo_remove(self):
        if self.phase != "browse" or not self.removed:
            return
        idx, was_kept = self.removed.pop()
        path = self.items[idx]
        review = rice.load_review()
        rel = str(path.relative_to(rice.WALLS))
        review["drop"].discard(rel)
        if was_kept:
            review["keep"].add(rel)
        rice.save_review(review)
        self.gone.discard(idx)
        if path == self.current:
            self.current_removed = False
        self.set_query(self.query)
        if idx in self.view:
            self.select(self.view.index(idx))
        self.toast = (f"Restored “{pretty(path)[1]}”", time.monotonic())

    def cancel(self):
        if self.phase not in ("browse", "open"):
            return
        if self.cur_full is not None:
            self.push_layer(self.cur_full, 0.2)
        self.phase, self.phase_tw = "cancel", Tween(0, 1, 0.5 if self.animate else 0.01, ease_in_out)

    def quit(self, code=None):
        if code is not None:
            self.exit_code = code
        self.closing = True
        self.wake.set()
        Gtk.main_quit()
        return True

    # ---------------------------------------------------------------- input

    def on_map(self, *_):
        seat = Gdk.Display.get_default().get_default_seat()
        GLib.timeout_add(80, lambda: seat.grab(self.get_window(), Gdk.SeatCapabilities.KEYBOARD, False, None, None, None) and False)

    def on_key(self, _w, ev):
        if self.phase not in ("open", "browse"):
            return True
        k = Gdk.keyval_name(ev.keyval)
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        moves = {"Right": 1, "Down": 1, "Left": -1, "Up": -1, "Page_Down": 8, "Page_Up": -8}
        if k in ("Delete", "KP_Delete") or (ctrl and k in ("z", "Z")):
            last = self.held.get(ev.keyval)
            self.held[ev.keyval] = ev.time
            if last is None or ev.time - last >= 700:  # a held key (auto-repeat) acts once
                self.remove_selected() if k in ("Delete", "KP_Delete") else self.undo_remove()
        elif k in moves:
            self.select(self.sel + moves[k])
        elif k == "Home":
            self.select(0)
        elif k == "End":
            self.select(len(self.view) - 1)
        elif k in ("Return", "KP_Enter"):
            self.confirm()
        elif k == "Escape":  # the current wallpaper removed: keep the one on show instead of going back
            self.set_query("") if self.query else (self.confirm() if self.current_removed and self.view else self.cancel())
        elif k == "BackSpace":
            self.set_query(self.query[:-1])
        elif k == "Tab":
            v = self.mock_tw.value(time.monotonic())
            self.mock_tw = Tween(v, 0.0 if self.mock_tw.b > 0.5 else 1.0, 0.25 if self.animate else 0.01)
            self.queue_draw()
        elif ctrl and k in ("u", "U"):
            self.set_query("")
        else:
            ch = chr(Gdk.keyval_to_unicode(ev.keyval)) if Gdk.keyval_to_unicode(ev.keyval) else ""
            if ch and ch.isprintable() and not ctrl:
                self.set_query(self.query + ch)
        return True

    def on_key_release(self, _w, ev):
        self.held.pop(ev.keyval, None)
        return True

    def on_motion(self, _w, ev):
        b = self.remove_btn
        hover = bool(b) and b[0] <= ev.x <= b[0] + b[2] and b[1] <= ev.y <= b[1] + b[3]
        if hover != self.hover_remove:
            self.hover_remove = hover
            self.queue_draw()
        return False

    def on_scroll(self, _w, ev):
        if self.phase == "browse":
            d = {Gdk.ScrollDirection.UP: -1, Gdk.ScrollDirection.LEFT: -1, Gdk.ScrollDirection.DOWN: 1,
                 Gdk.ScrollDirection.RIGHT: 1}.get(ev.direction)
            if d is None:
                ok, dx, dy = ev.get_scroll_deltas()
                d = (1 if dx + dy > 0 else -1) if ok and abs(dx + dy) > 0.3 else 0
            if d:
                self.select(self.sel + d)
        return True

    def on_click(self, _w, ev):
        if self.phase != "browse":
            return True
        b = self.remove_btn
        if b and b[0] <= ev.x <= b[0] + b[2] and b[1] <= ev.y <= b[1] + b[3]:
            self.remove_selected()
            return True
        if self.cx <= ev.x <= self.cx + self.cw and self.cy <= ev.y <= self.cy + self.ch:
            self.confirm()
            return True
        tw, gap, fy = self.film_geometry()
        if fy - tw * 0.3 <= ev.y <= fy + tw * 0.75:
            d = round((ev.x - self.W / 2) / (tw + gap) + self.pos - self.sel)
            if d:
                self.select(self.sel + d)
        return True

    # ---------------------------------------------------------------- animation clock

    def tick(self, _widget, _clock):
        now = time.monotonic()
        dt, self.last = min(0.1, now - self.last), now
        busy = False
        if self.view:
            target = float(self.sel)
            if abs(target - self.pos) > 0.002:
                self.pos += (target - self.pos) * (1 - math.exp(-dt * 13)) if self.animate else target - self.pos
                busy = True
            else:
                self.pos = target
        for layers in (self.layers, self.backs):
            while len(layers) > 1 and layers[1]["tw"].done(now):
                layers.pop(0)  # fully covered by the next one
            busy = busy or any(not l["tw"].done(now) for l in layers)
        busy = busy or not self.theme_tw.done(now) or not self.mock_tw.done(now) or not self.phase_tw.done(now)
        busy = busy or any(now - t < 0.3 for t in self.loaded_at.values())
        self.dropping = [d for d in self.dropping if not d["tw"].done(now)]
        busy = busy or bool(self.dropping) or bool(self.gap and not self.gap[1].done(now))
        busy = busy or bool(self.toast and now - self.toast[1] < 3.6)
        if self.phase == "open" and self.phase_tw.done(now):
            self.phase = "browse"
            if self.view:  # the opening showed the current wallpaper; settle on the selected one
                src = self.get("card", self.view[self.sel]) or self.get("thumb", self.view[self.sel])
                if src is not None:  # even the same picture: the card-sized copy is much cheaper to draw
                    self.push_layer(src)
        if self.phase == "confirm" and self.phase_tw.done(now) and self.apply_done and now - self.apply_done > 0.25:
            return self.quit()
        if self.phase == "cancel" and self.phase_tw.done(now):
            return self.quit(1)
        if busy or self.phase in ("confirm", "cancel", "open"):
            self.queue_draw()
        return True

    # ---------------------------------------------------------------- drawing

    def card_rect(self, now):
        """Full screen while opening/closing, the card while browsing."""
        if self.phase == "open":
            t = self.phase_tw.value(now)
        elif self.phase in ("confirm", "cancel"):
            t = 1 - self.phase_tw.value(now)
        else:
            t = 1.0
        return (lerp(0, self.cx, t), lerp(0, self.cy, t), lerp(self.W, self.cw, t), lerp(self.H, self.ch, t), t)

    def ui_alpha(self, now):
        if self.phase == "open":
            return ease_out(clamp((self.phase_tw.progress(now) - 0.35) / 0.65))
        if self.phase in ("confirm", "cancel"):
            return 1 - ease_out(clamp(self.phase_tw.progress(now) / 0.45))
        return 1.0

    def film_geometry(self):
        tw = self.H * 0.16  # 16:9 thumbnails 0.09 of the screen height tall
        return tw, tw * 0.12, self.H * 0.85

    def on_draw(self, _w, cr):
        now = time.monotonic()
        th = self.theme_now(now)
        x, y, w, h, t = self.card_rect(now)
        ui = self.ui_alpha(now)
        # backdrop: the selected picture, blurred and darkened (the sharp current one while opening)
        cr.set_source_rgb(*th["bg"])
        cr.paint()
        if self.phase == "open" and self.cur_full is not None:
            cr.set_source_surface(self.cur_full, 0, 0)
            cr.paint()
        for b in self.backs:
            a = b["tw"].value(now) * (t if self.phase in ("open", "cancel", "confirm") else 1.0)
            paint_scaled(cr, b["src"], 0, 0, self.W, self.H, a, cairo.FILTER_GOOD)
        cr.set_source_rgba(*th["bg"], 0.62 * t)
        cr.paint()
        if self.items:
            self.draw_card(cr, now, th, x, y, w, h, t)
        if ui > 0.01:
            self.draw_ui(cr, now, th, ui)
        return True

    def draw_card(self, cr, now, th, x, y, w, h, t):
        r = 18 * t
        if t > 0.02:  # soft shadow under the card
            for i in range(6):
                rrect(cr, x - i * 3, y - i * 3 + 10, w + i * 6, h + i * 6, r + i * 3)
                cr.set_source_rgba(0, 0, 0, 0.07 * t)
                cr.fill()
        cr.save()
        rrect(cr, x, y, w, h, r)
        cr.clip()
        big = w > self.cw * 1.05
        target = self.target if self.phase == "confirm" else None
        for layer in self.layers:
            src = layer["src"]
            if big and target is not None:
                src = self.get("full", target) or self.get("card", target) or src
            paint_scaled(cr, src, x, y, w, h, layer["tw"].value(now), cairo.FILTER_GOOD if not big else cairo.FILTER_BILINEAR)
        mock = self.mock_tw.value(now) * clamp((t - 0.55) / 0.45)
        if mock > 0.01:
            cr.save()
            cr.translate(x, y)
            cr.scale(w / self.W, h / self.H)
            self.draw_mock(cr, th, mock)
            cr.restore()
        cr.restore()
        if t > 0.02:
            rrect(cr, x + 0.5, y + 0.5, w - 1, h - 1, r)
            cr.set_source_rgba(*th["accent"], 0.85 * t)
            cr.set_line_width(2)
            cr.stroke()
        for d in self.dropping:  # a removed wallpaper falls away, tinted red
            k = d["tw"].value(now)
            cr.save()
            cr.translate(x + w / 2, y + h / 2 + self.H * 0.5 * k)
            cr.rotate(-0.14 * k)
            cr.scale(1 - 0.15 * k, 1 - 0.15 * k)
            rrect(cr, -w / 2, -h / 2, w, h, r)
            cr.clip()
            paint_scaled(cr, d["src"], -w / 2, -h / 2, w, h, 1 - k, cairo.FILTER_BILINEAR)
            cr.set_source_rgba(*THEME["remove"], 0.45 * (1 - k))
            cr.paint()
            cr.restore()
        self.remove_btn = None
        if self.phase == "browse" and self.view:  # ✕ in the card's corner removes the wallpaper
            br = max(14, self.H * 0.022)
            bx, by = x + w - br - 14, y + br + 14
            cr.arc(bx, by, br, 0, 2 * math.pi)
            cr.set_source_rgba(*(THEME["remove"] if self.hover_remove else (0, 0, 0)), 0.9 if self.hover_remove else 0.5)
            cr.fill()
            text(cr, "✕", bx, by - br * 0.62, br * 1.1, (1, 1, 1), 1, "Bold", align="center")
            self.remove_btn = (bx - br, by - br, 2 * br, 2 * br)

