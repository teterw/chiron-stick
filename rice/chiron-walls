        cr.fill()

        # conky
        kx, ky, kw, kh = W - 262, 46, 236, 150
        rrect(cr, kx, ky, kw, kh, 6)
        cr.set_source_rgba(*s1, 0.85 * a)
        cr.fill()
        text(cr, "CHIRON", kx + 12, ky + 8, 13, acc, a, font=MONO)
        cr.rectangle(kx + 74, ky + 17, kw - 88, 1)
