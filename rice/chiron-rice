    """The picker and the review in the app menu (Super+D), so neither needs a terminal."""
    apps = HOME / ".local/share/applications"
    apps.mkdir(parents=True, exist_ok=True)
    for name, title, comment, args, icon in (
            ("chiron-wallpapers", "Wallpapers", "Pick a wallpaper; the desktop takes its colours", "pick",
             "preferences-desktop-wallpaper"),
            ("chiron-wallpaper-review", "Review wallpapers", "Keep or remove each downloaded wallpaper", "walls review",
             "view-preview")):
        (apps / f"{name}.desktop").write_text(
            f"[Desktop Entry]\nType=Application\nName={title}\nComment={comment}\n"
            f"Exec={RICE / 'chiron-rice'} {args}\nIcon={icon}\nCategories=Settings;DesktopSettings;\nTerminal=false\n")


WM_THEME = "Chiron-wm"
XFWM_BASE = Path("/usr/share/themes/Default/xfwm4")
# Soft GNOME-like shadow: about 22 px at the sides, 14 above, 30 below. xfwm4 blurs over a fixed 36 px
# box, so x/width/y/height = side-18 / side-18 / top-18 / bottom-18 (signs as xfwm4's settings.c reads them).
WM_SHADOW = {"shadow_opacity": 70, "shadow_delta_x": 4, "shadow_delta_width": 4,
             "shadow_delta_y": -4, "shadow_delta_height": 12}


def wm_theme():
    """xfwm4 takes shadow sizes only from the window theme's themerc, never from xfconf. So Chiron-wm
    is Mint's Default theme (its pictures linked, not copied) with a bigger, softer shadow."""
    out = HOME / ".local/share/themes" / WM_THEME / "xfwm4"
    out.mkdir(parents=True, exist_ok=True)
    for f in XFWM_BASE.iterdir():
        link = out / f.name
        if f.name != "themerc" and not (link.is_symlink() and link.resolve() == f):
            link.unlink(missing_ok=True)
            link.symlink_to(f)
    rc = [l for l in (XFWM_BASE / "themerc").read_text().splitlines() if not l.startswith("shadow_")]
    write_atomic(out / "themerc", "\n".join(rc + [f"{k}={v}" for k, v in WM_SHADOW.items()]) + "\n")


SHOTS = HOME / "Pictures" / "Screenshots"


def screenshot_cmd(flag):
    """Save without asking: given a folder, xfce4-screenshooter still opens its Save dialog; given a
    file name it just saves. Shortcuts don't run through a shell, so sh -c makes the timestamp."""
    return f"sh -c 'xfce4-screenshooter {flag} -s \"{SHOTS}/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png\"'"


COMMAND_KEYS = (("<Super>w", f"{RICE / 'chiron-rice'} pick"), ("<Super><Shift>w", f"{RICE / 'chiron-rice'} random"),
                ("<Super>Return", "xfce4-terminal"), ("<Super>d", "rofi -show drun"), ("<Super>e", "thunar"),
                ("<Super>l", "xflock4"), ("Print", screenshot_cmd("-f")), ("<Shift>Print", screenshot_cmd("-r")),
                ("<Super>q", "wmctrl -c :ACTIVE:"),  # a command: xfwm4's close keeps Alt+F4 (one key per action)
                ("<Alt>F1", "xfce4-popup-whiskermenu"))  # what a tap of Super sends (xcape)
# xfwm4 keeps one key per action, so these replace Mint's Ctrl+Alt+D, Super+keypad ←/→, Alt+F10, Alt+F9
WM_KEYS = (("<Super>m", "show_desktop_key"),  # again: the windows come back
           ("<Super>Left", "tile_left_key"), ("<Super>Right", "tile_right_key"),
           ("<Super>Up", "maximize_window_key"),  # again: back to its old size
           ("<Super>Down", "hide_window_key"))
# Mint opens the menu with a bare Super_L binding. xfsettingsd then grabs the whole keyboard while Super
# is held, so no Super+key reaches xfwm4 (Super+M, Super+Tab, tiling: all dead). xcape turns a tap of
# Super into Alt+F1 instead, and Super combos reach the window manager again.
XCAPE = 'xcape -e "Super_L=Alt_L|F1"'


def wm_key_conflicts(listing):
    """xfconf paths to remove (from `xfconf-query -lv`): other keys bound to the xfwm4 actions WM_KEYS
    sets, and xfwm4 bindings of keys that are commands here (the command would never run)."""
    ours, commands = dict(WM_KEYS), dict(COMMAND_KEYS)
    out = []
    for line in listing.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0].startswith("/xfwm4/custom/"):
            key, action = parts[0][len("/xfwm4/custom/"):], parts[1].strip()
            if (action in ours.values() and ours.get(key) != action) or key in commands:
                out.append(parts[0])
    return out


def install_user():
    layout = load_layout()
    # Look and feel
    for prop, val in (("/Net/ThemeName", GTK_THEME), ("/Net/IconThemeName", ICON_THEME),
                      ("/Gtk/CursorThemeName", "Bibata-Modern-Classic"), ("/Gtk/FontName", "Noto Sans 10"),
                      ("/Gtk/MonospaceFontName", "JetBrainsMono Nerd Font 10")):
        xfconf("xsettings", prop, val)
    wm_theme()
    xfconf("xfwm4", "/general/theme", WM_THEME)
    xfconf("xfwm4", "/general/show_frame_shadow", True, "bool")
    xfconf("xfwm4", "/general/frame_opacity", 100, "int")
    xfconf("xfce4-terminal", "/font-name", "JetBrainsMono Nerd Font 11")
    xfconf("xfce4-terminal", "/misc-menubar-default", False, "bool")
    xfconf("xfce4-desktop", "/desktop-icons/style", 0, "int")  # clean desktop, like the reference look
    xfconf_array("xfwm4", "/general/workspace_names", ["1", "2", "3", "4"], "string")
    # Keyboard shortcuts
    SHOTS.mkdir(parents=True, exist_ok=True)
    for key, cmd in COMMAND_KEYS:
        xfconf("xfce4-keyboard-shortcuts", f"/commands/custom/{key}", cmd)
    rc, listing = sh("xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-lv")
    for path in wm_key_conflicts(listing if rc == 0 else ""):
        sh("xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", path, "-r")
    for key, action in WM_KEYS:
        xfconf("xfce4-keyboard-shortcuts", f"/xfwm4/custom/{key}", action)
    if shutil.which("xcape"):  # tap Super = menu, without breaking Super combos (see XCAPE)
        sh("xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", "/commands/custom/Super_L", "-r")
        sh("pkill", "-x", "xcape")
        subprocess.Popen(["sh", "-c", XCAPE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    # A key xfwm4 held when xfsettingsd tried to grab it stays dead until xfsettingsd grabs again
    subprocess.Popen(["xfsettingsd", "--replace"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    # Lock after 10 minutes idle, on suspend and on closing the lid (light-locker, which xflock4 uses).
    # The stick logs in by itself after the LUKS passphrase, so the lock is what guards it when left alone.
    for prop, val, kind in (("dpms-enabled", True, "bool"), ("blank-on-ac", 10, "int"),
                            ("blank-on-battery", 10, "int"), ("lock-screen-suspend-hibernate", True, "bool")):
        xfconf("xfce4-power-manager", f"/xfce4-power-manager/{prop}", val, kind)
    for key in ("lock-on-suspend", "lock-on-lid"):
        sh("gsettings", "set", "apps.light-locker", key, "true")
    # Panels: rebuild from panel-layout.json
    sh("xfce4-panel", "--quit")
    sh("xfconf-query", "-c", "xfce4-panel", "-p", "/", "-R", "-r")
    panel_root = HOME / ".config/xfce4/panel"
    shutil.rmtree(panel_root, ignore_errors=True)
    pid, panel_ids = 0, []
    for n, panel in enumerate(layout["panels"], 1):
        panel_ids.append(n)
        ids = []
        base = f"/panels/panel-{n}"
        for k, v, kind in (("position", panel["position"], "string"), ("size", panel["size"], "uint"),
                           ("length", panel["length"], "uint"), ("position-locked", True, "bool"),
                           ("length-adjust", True, "bool"), ("icon-size", panel.get("icon_size", 0), "uint"),
                           ("autohide-behavior", panel.get("autohide", 0), "uint"), ("background-style", 0, "uint"),
                           ("nrows", 1, "uint"), ("mode", 0, "uint")):
            xfconf("xfce4-panel", f"{base}/{k}", v, kind)
        for item in panel["items"]:
            for plugin in (["separator:expand"] if item == "expand" else item):
                pid += 1
                ids.append(pid)
                kind, _, arg = plugin.partition(":")
                pp = f"/plugins/plugin-{pid}"
                xfconf("xfce4-panel", pp, kind)
                if kind == "separator":
                    xfconf("xfce4-panel", f"{pp}/expand", True, "bool")
                    xfconf("xfce4-panel", f"{pp}/style", 0, "uint")
                elif kind == "launcher":
                    l = layout["launchers"][arg]
                    d = panel_root / f"launcher-{pid}"
                    d.mkdir(parents=True, exist_ok=True)
                    (d / f"chiron-{arg}.desktop").write_text(
                        "[Desktop Entry]\nVersion=1.0\nType=Application\n" +
                        "".join(f"{k}={v.replace('{HOME}', str(HOME))}\n" for k, v in l.items()) +
                        "Terminal=false\nStartupNotify=true\n")
                    xfconf_array("xfce4-panel", f"{pp}/items", [f"chiron-{arg}.desktop"], "string")
                elif kind == "pager":
                    xfconf("xfce4-panel", f"{pp}/rows", 1, "uint")
                    xfconf("xfce4-panel", f"{pp}/miniature-view", False, "bool")
                elif kind == "clock":
                    xfconf("xfce4-panel", f"{pp}/digital-layout", 3, "uint")
                    xfconf("xfce4-panel", f"{pp}/digital-time-format", "%H:%M")
                elif kind == "whiskermenu":
                    xfconf("xfce4-panel", f"{pp}/button-icon", "view-app-grid-symbolic")
                elif kind == "systemload":  # settings live in xfconf as /<monitor>/<setting> (systemload 1.3)
                    for k, v, t in (("cpu/enabled", True, "bool"), ("cpu/use-label", True, "bool"), ("cpu/label", "cpu", "string"),
                                    ("memory/enabled", True, "bool"), ("memory/use-label", True, "bool"), ("memory/label", "mem", "string"),
                                    ("network/enabled", True, "bool"), ("network/use-label", True, "bool"), ("network/label", "net", "string"),
                                    ("swap/enabled", False, "bool"), ("uptime/enabled", False, "bool")):
                        xfconf("xfce4-panel", f"{pp}/{k}", v, t)
                elif kind == "windowck-plugin":  # settings live in an rc file; show every window's title
                    (panel_root / f"windowck-plugin-{pid}.rc").write_text(
                        "only_maximized=false\nshow_on_desktop=false\nfull_name=true\ntwo_lines=false\nshow_tooltips=true\n"
                        "size_mode=2\ntitle_size=60\nsync_wm_font=false\ntitle_font=Noto Sans 10\nsubtitle_font=Noto Sans 9\n"
                        "title_alignment=5\ntitle_padding=6\ninactive_text_alpha=60\ninactive_text_shade=110\n")
        xfconf_array("xfce4-panel", f"{base}/plugin-ids", ids, "int")
    xfconf_array("xfce4-panel", "/panels", panel_ids, "int")
    subprocess.Popen(["xfce4-panel"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    # Static configs (rofi, btop, bash). wallust needs none (run_wallust passes everything), and its
    # cache from earlier versions only takes space.
    for src, dst in ((RICE / "rofi" / "config.rasi", HOME / ".config/rofi/config.rasi"),):
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
    shutil.rmtree(HOME / ".cache/wallust", ignore_errors=True)
    btop = HOME / ".config/btop/btop.conf"
    btop.parent.mkdir(parents=True, exist_ok=True)
    text = btop.read_text() if btop.exists() else ""
    lines = [l for l in text.splitlines() if not l.startswith(("color_theme", "theme_background"))]
    btop.write_text("\n".join(lines + ['color_theme = "chiron"', "theme_background = False"]) + "\n")
    bashrc = HOME / ".bashrc"
    block = ("\n# >>> chiron-rice >>>\n"
             "command -v starship >/dev/null && eval \"$(starship init bash)\"\n"
             "[ -n \"$PS1\" ] && command -v fastfetch >/dev/null && [ -z \"$CHIRON_NO_FETCH\" ] && fastfetch\n"
             "# <<< chiron-rice <<<\n")
    text = bashrc.read_text() if bashrc.exists() else ""
    if "# >>> chiron-rice >>>" not in text:
        bashrc.write_text(text + block)
    install_launchers()
    # Autostart and rotation timer
    auto = HOME / ".config/autostart"
    auto.mkdir(parents=True, exist_ok=True)
    (auto / "chiron-rice.desktop").write_text(
        "[Desktop Entry]\nType=Application\nName=Chiron desktop theme\nExec=/opt/chiron/rice/chiron-rice login\n"
        "X-GNOME-Autostart-enabled=true\nNoDisplay=true\n")
    (auto / "chiron-xcape.desktop").write_text(
        "[Desktop Entry]\nType=Application\nName=Chiron: tap Super for the menu\n"
        f"Exec={XCAPE}\nX-GNOME-Autostart-enabled=true\nNoDisplay=true\n")
    units = HOME / ".config/systemd/user"
    units.mkdir(parents=True, exist_ok=True)
    (units / "chiron-rice-rotate.service").write_text(
        "[Unit]\nDescription=Chiron Stick: next wallpaper\n\n[Service]\nType=oneshot\n"
        "ExecStart=/opt/chiron/rice/chiron-rice next\n")
    (units / "chiron-rice-rotate.timer").write_text(
        "[Unit]\nDescription=Chiron Stick: change the wallpaper every 30 minutes\n\n[Timer]\n"
        "OnActiveSec=30min\nOnUnitActiveSec=30min\n\n[Install]\nWantedBy=timers.target\n")
    (units / "chiron-conky.service").write_text(  # started by login(), not enabled
        "[Unit]\nDescription=Chiron Stick: system stats on the desktop (conky)\n\n[Service]\n"
        f"ExecStart={shutil.which('conky') or '/usr/bin/conky'} -c %h/.config/conky/chiron.conf\n"
        "Restart=on-failure\nRestartSec=3\n")
    sh("systemctl", "--user", "daemon-reload")
    sh("systemctl", "--user", "enable", "--now", "chiron-rice-rotate.timer")
    state = load_state()
    first = state.get("wallpaper")
    if not first or not Path(first).exists():
        pics = wallpapers(state.get("mode", "personal"))
        first = random.choice(pics) if pics else None
    if first:
        apply(first)
    login()  # after the first apply: that's what writes the conky config login() starts conky with
    print("Desktop set up. Super+W picks a wallpaper; `chiron walls update` downloads the collection.")


def restart_conky():
    """conky runs as a user service: reloading it with a signal can make it abort on an X error, and a
    conky started from the rotation timer would be stopped together with the timer's job."""
    if shutil.which("conky") and (HOME / ".config/conky/chiron.conf").exists():
        sh("systemctl", "--user", "reset-failed", "chiron-conky.service")
        sh("systemctl", "--user", "--no-block", "restart", "chiron-conky.service")  # don't wait: it takes ~1.5 s


def login():
    """Session start. A pause only lasts for a test, so one left over from a crash or reboot ends here.
    No compositor on software rendering (VMs, missing GPU drivers): it would be slow. The theme is made
    for one or the other (see-through panel and conky or not), so it's redone when that changed."""
    sh("systemctl", "--user", "import-environment", "DISPLAY", "XAUTHORITY")  # for chiron-conky.service
    state = load_state()
    if state.get("paused"):
        state["paused"] = False
        save_state(state)
    timer("start" if state.get("mode", "personal") == "personal" else "stop")
    composite = not software_rendering()
    xfconf("xfwm4", "/general/use_compositing", composite, "bool")
    wall = state.get("wallpaper")
    if wall and Path(wall).is_file() and state.get("solid") != (not composite):
        apply(wall, quiet=True)  # restarts conky too
    else:
        if wall and Path(wall).is_file():  # this PC's screen may not be the last one's size
            time.sleep(1.5)  # let the panels come up first
            dock_backdrop(wall, load_layout(), not composite)
        restart_conky()


# ---------------------------------------------------------------- command line

def main(argv):
    session_env()
    cmd = argv[0] if argv else "status"
    state = load_state()
    if cmd == "apply" and len(argv) == 2:
        apply(argv[1], transition="random")
    elif cmd == "pick":
        pick()
    elif cmd == "random":
        apply(random.choice(wallpapers(state.get("mode", "personal"))), transition="random")
    elif cmd == "next":
        if state.get("mode", "personal") == "personal" and not state.get("paused"):
            apply(random.choice(wallpapers("personal")), quiet=True, transition="random")
    elif cmd == "mode" and len(argv) == 2 and argv[1] in ("client", "personal"):
        state["mode"] = argv[1]
        save_state(state)
        timer("start" if argv[1] == "personal" and not state.get("paused") else "stop")
        apply(random.choice(wallpapers(argv[1])), transition="random")
        print(f"mode: {argv[1]}" + (" (calm wallpapers, no rotation)" if argv[1] == "client" else ""))
    elif cmd in ("pause", "resume"):
        set_pause(cmd == "pause")
    elif cmd == "animations" and len(argv) == 2 and argv[1] in ("on", "off"):
        state["animations"] = argv[1] == "on"
        save_state(state)
        print(f"animations: {argv[1]}")
    elif cmd == "login":
        login()
    elif cmd == "thumbs":
        n = build_thumbs(wallpapers(state.get("mode", "personal")))
        print(f"{n} new thumbnails")
    elif cmd == "cputemp":
        cputemp()
    elif cmd == "walls" and len(argv) == 2 and argv[1] in ("update", "review", "status"):
        if argv[1] == "update":
            walls_update()
        elif argv[1] == "review":
            return subprocess.call([str(RICE / "chiron-walls"), "review"])
        else:
            walls_status()
    elif cmd == "install-user":
        install_user()
    elif cmd == "status":
        print(json.dumps(state, indent=1))
    else:
        print(__doc__)
        return 2
    finish_transitions()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
