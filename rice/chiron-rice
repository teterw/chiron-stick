# Papirus folder colours and their approximate RGB, to pick the one nearest the accent
PAPIRUS = {"blue": "#5294e2", "bluegrey": "#607d8b", "brown": "#ae8e6c", "cyan": "#00bcd4", "darkcyan": "#45abb7",
           "deeporange": "#eb6637", "green": "#87b158", "grey": "#8e8e8e", "indigo": "#5c6bc0", "magenta": "#ca71df",
           "orange": "#ee923a", "pink": "#f06292", "red": "#e25252", "teal": "#16a085", "violet": "#7e57c2",
           "yellow": "#f9bd30", "palebrown": "#d1bfae", "paleorange": "#eecaab", "carmine": "#a30002", "nordic": "#81a1c1"}


def papirus_color(accent):
    base = Path("/usr/share/icons/Papirus/48x48/places")
    have = {n for n in PAPIRUS if (base / f"folder-{n}.svg").exists()}
    h1, l1, s1 = colorsys.rgb_to_hls(*accent)

    def dist(name):
        h2, l2, s2 = colorsys.rgb_to_hls(*hex2rgb(PAPIRUS[name]))
        dh = min(abs(h1 - h2), 1 - abs(h1 - h2))
        return dh * 3 + abs(l1 - l2) + abs(s1 - s2) * (1.5 if s1 < 0.2 else 0.5)
    return min(have or {"blue"}, key=dist)


def papirus_overlay(color):
    """Per-user icon theme that inherits Papirus-Dark and only re-points the folder icons to `color`
    (what papirus-folders does, without root and without touching the system theme)."""
    src = Path("/usr/share/icons/Papirus")
    dst = HOME / ".local" / "share" / "icons" / ICON_THEME
    if not src.is_dir():
        return
    dirs = []
    sizes = [p for p in src.iterdir() if p.is_dir() and (p / "places").is_dir()
             and (p.name == "symbolic" or (p.name[0].isdigit() and "@" not in p.name))]
    for size_dir in sorted(sizes):
        out = dst / size_dir.name / "places"
        shutil.rmtree(out, ignore_errors=True)
        out.mkdir(parents=True, exist_ok=True)
        for link in (size_dir / "places").iterdir():
            if not link.is_symlink():
                continue
            # Follow the whole chain (folder-videos -> folder-blue-videos, some via a second link)
            target = Path(os.path.realpath(link)).name
            if "-blue" in target:  # Papirus' default folder colour
                new = size_dir / "places" / target.replace("-blue", f"-{color}")
                if new.exists():
                    (out / link.name).symlink_to(new)
        dirs.append(f"{size_dir.name}/places")
    write_atomic(dst / "index.theme", "[Icon Theme]\nName=Papirus-Chiron\nComment=Papirus-Dark with folders in the wallpaper's colour\n"
                 # Papirus-Dark is complete on its own: also inheriting Papirus would make every GTK
                 # program index that theme too
                 "Inherits=Papirus-Dark,hicolor\n" f"Directories={','.join(dirs)}\n\n" +
                 "".join(f"[{d}]\nContext=Places\nSize={int(d.split('x')[0]) if d[0].isdigit() else 48}\nType=Fixed\n\n"
                         if d[0].isdigit() else f"[{d}]\nContext=Places\nSize=48\nType=Scalable\nMinSize=8\nMaxSize=512\n\n"
                         for d in dirs))
    sh("gtk-update-icon-cache", "-f", "-q", str(dst))


# ---------------------------------------------------------------- panel layout

def load_layout():
    return json.loads((RICE / "panel-layout.json").read_text())


def islands(layout):
    """Plugin ids are given in order across all panels, so setup and CSS agree without lookups."""
    out, pid = [], 0
    for panel in layout["panels"]:
        for item in panel["items"]:
            if item == "expand":
                pid += 1
                continue
            widgets = []
            for plugin in item:
                pid += 1
                kind = plugin.split(":")[0]
                widgets.append(f"{kind}-{pid}")
            out.append({"panel": panel["name"], "widgets": widgets})
    return out


# ---------------------------------------------------------------- applying

def compositing():
    return xfconf_get("xfwm4", "/general/use_compositing") == "true"


def set_wallpaper(img):
    rc, out = sh("xfconf-query", "-c", "xfce4-desktop", "-l")
    props = [p for p in out.split() if p.endswith("/last-image")] if rc == 0 else []
    if not props:
        rc, mons = sh("xrandr", "--listmonitors")
        names = [l.split()[-1] for l in mons.splitlines()[1:]] if rc == 0 else ["Virtual-1"]
        props = [f"/backdrop/screen0/monitor{n}/workspace{w}/last-image" for n in names for w in range(4)]
    for p in props:
        xfconf("xfce4-desktop", p, str(img))
        xfconf("xfce4-desktop", p.replace("last-image", "image-style"), 5, "int")  # zoomed


def run_wallust(img):
    """The wallpaper's 16 colours. wallust just prints them (no config, no templates) and keeps no
    cache: its own cache takes megabytes per image and would grow with every wallpaper. Ours keeps
    the 16 colours per image (the picker previews them too, so preview and result always match)."""
    img = Path(img)
    st = img.stat()
    cache = CACHE / "palettes" / (hashlib.sha1(f"{img}|{st.st_size}|{int(st.st_mtime)}".encode()).hexdigest() + ".json")
    try:
        return json.loads(cache.read_text())
    except (OSError, ValueError):
        pass
    try:  # not sh(): wallust explains failures on stderr
        p = subprocess.run(["wallust", "run", "-N", "-s", "-T", "-n", "-q", "-b", "fastresize", "-c", "salience",
                            "-p", "saliencedark", "-k", "--print-scheme", str(img)], capture_output=True, text=True, timeout=60)
        rc, why = p.returncode, (p.stderr.strip() or "no output").splitlines()[0]
        hexes = [l.strip() for l in p.stdout.splitlines() if l.strip().startswith("#")]
    except (OSError, subprocess.TimeoutExpired) as e:
        rc, why, hexes = 1, str(e), []
    if rc != 0 or len(hexes) < 16:
        raise SystemExit(f"chiron-rice: wallust couldn't read colours from {img}: {why}")
    palette = {f"color{i}": h for i, h in enumerate(hexes[:16])}
    palette.update(background=hexes[0], foreground=hexes[15], cursor=hexes[7])
    write_atomic(cache, json.dumps(palette))
    return palette


def gtk_theme_files(c, layout, solid):
    """GTK3 programs read ~/.config/gtk-3.0/gtk.css only at startup, but re-read a *theme* whenever the
    theme changes. So the colours live in a generated theme kept in two copies, Chiron-a and Chiron-b:
    write the one not in use, then switch to it, and every running program restyles at once.
    Returns the theme name and its files ({path: text})."""
    current = xfconf_get("xsettings", "/Net/ThemeName")
    name = "Chiron-b" if current == "Chiron-a" else "Chiron-a"
    root = HOME / ".local/share/themes" / name
    base = Path("/usr/share/themes") / GTK_THEME
    files = {}
    for ver, lay in (("gtk-3.0", layout), ("gtk-4.0", {"panels": []})):
        imp = f'@import url("file://{base / ver / "gtk.css"}");\n' if (base / ver / "gtk.css").exists() else ""
        files[root / ver / "gtk.css"] = imp + gtk_css(c, lay, solid)
    files[root / "index.theme"] = ("[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Chiron\n"
                                   "Comment=Clinic Night: adw-gtk3-dark coloured from the wallpaper (chiron-rice)\n"
                                   f"Encoding=UTF-8\n\n[X-GNOME-Metatheme]\nGtkTheme={name}\n")
    return name, files


def apply(img, quiet=False, transition=None):
    """transition: animate the change behind the windows (chiron-walls effect name, or "random")."""
    img = Path(img).expanduser().resolve()
    if not img.is_file() or img.suffix.lower() not in IMAGE_EXT:
        raise SystemExit(f"chiron-rice: not an image: {img}")
    old = load_state().get("wallpaper")
    # Work out everything before changing anything: if wallust or any step here fails, the old theme
    # stays whole instead of the desktop ending up half-themed.
    palette = run_wallust(img)
    c = derive(palette)
    layout = load_layout()
    solid = not compositing()
    theme, files = gtk_theme_files(c, layout, solid)
    files.update({
        # Personal gtk.css would override the theme with stale colours until a restart, so keep it empty;
        # GTK4/libadwaita apps don't use GTK themes, so they get the colours there (read when they start).
        HOME / ".config/gtk-3.0/gtk.css": "/* Chiron colours live in ~/.local/share/themes/Chiron-a|b (chiron-rice) */\n",
        HOME / ".config/gtk-4.0/gtk.css": gtk_css(c, {"panels": []}, solid),
        HOME / ".config/rofi/chiron-colors.rasi": rofi_colors(c),
        HOME / ".config/btop/themes/chiron.theme": btop_theme(c),
        HOME / ".config/conky/chiron.conf": conky_conf(c, argb=not solid),
        HOME / ".config/starship.toml": starship_toml(c),
        HOME / ".config/fastfetch/config.jsonc": fastfetch_jsonc(c),
    })
    folders = papirus_color(c["accent"])
    for path, text in files.items():
        write_atomic(path, text)
    if transition and start_transition(old, img, transition):
        time.sleep(0.7)  # let the new wallpaper sweep in halfway, then recolour everything with it
    xfconf("xfce4-terminal", "/color-use-theme", False, "bool")
    xfconf("xfce4-terminal", "/color-foreground", rgb2hex(c["fg"]))
    xfconf("xfce4-terminal", "/color-background", rgb2hex(c["bg"]))
    xfconf("xfce4-terminal", "/color-cursor", rgb2hex(c["accent"]))
    xfconf("xfce4-terminal", "/color-palette", ";".join(rgb2hex(t) for t in c["term"]))
    papirus_overlay(folders)
    # systemload graph bars in the accent colour (GdkRGBA is stored as 4 doubles in xfconf)
    r, g, b = c["accent"]
    for island in islands(layout):
        for w in island["widgets"]:
            if w.startswith("systemload-"):
                for k in ("cpu/color", "memory/color", "network/color", "swap/color"):
                    sh("xfconf-query", "-c", "xfce4-panel", "-p", f"/plugins/plugin-{w.split('-')[-1]}/{k}", "-n", "-a",
                       "-t", "double", "-s", f"{r:.3f}", "-t", "double", "-s", f"{g:.3f}",
                       "-t", "double", "-s", f"{b:.3f}", "-t", "double", "-s", "1.0")
    set_wallpaper(img)
    xfconf("xsettings", "/Net/ThemeName", theme)  # switching to the freshly written theme restyles everything
    xfconf("xsettings", "/Net/IconThemeName", "Papirus-Dark")  # same trick for the folder colours; the pause
    time.sleep(0.4)                                            # lets programs see two separate changes
    xfconf("xsettings", "/Net/IconThemeName", ICON_THEME)
    restart_conky()
    state = load_state()
    state["wallpaper"] = str(img)
    state["solid"] = solid  # login() redoes the theme when the compositor setting changes
    save_state(state)
    if not quiet:
        print(f"applied {img.name}: accent {rgb2hex(c['accent'])}, background {rgb2hex(c['bg'])}")


TRANSITIONS = []  # running chiron-walls transition processes


def start_transition(old, new, effect="random"):
    """swww-style animated wallpaper change behind the windows (chiron-walls transition). Returns once
    the animation covers the desktop, so the switch underneath stays hidden. Skipped when animations
    are off, during a test pause, or without an old wallpaper to animate from."""
    state = load_state()
    if (state.get("paused") or not state.get("animations", True) or not old or not Path(old).is_file()
            or Path(old) == Path(new) or not os.environ.get("DISPLAY")):
        return False
    try:
        p = subprocess.Popen([str(RICE / "chiron-walls"), "transition", str(old), str(new), effect],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return False
    ready, _, _ = select.select([p.stdout], [], [], 4.0)
    if not ready or p.stdout.readline().strip() != "ready":
        p.kill()  # never leave a stuck animation over the desktop
        return False
    TRANSITIONS.append(p)
    return True


def finish_transitions():
    """Wait for running animations: a timer job's processes end with the job."""
    for p in TRANSITIONS:
        try:
            p.wait(timeout=8)
        except subprocess.TimeoutExpired:
            p.kill()


def pick():
    """The full-screen picker (chiron-walls); rofi if GTK can't start."""
    rc = subprocess.call([str(RICE / "chiron-walls"), "pick"])
    if rc == 3:
        pick_rofi()


def pick_rofi():
    state = load_state()
    pics = wallpapers(state.get("mode", "personal"))
    new = build_thumbs(pics, quiet=True)
    if new:
        sh("notify-send", "Chiron", f"Made {new} new wallpaper thumbnails")
    lines = "".join(f"{p.parent.name}/{p.name}\0icon\x1f{thumb_path(p)}\n" for p in pics)
    # stderr is not captured: if rofi cannot open (e.g. it fails to grab the keyboard), its error
    # reaches the terminal or ~/.xsession-errors instead of vanishing.
    p = subprocess.run(["rofi", "-dmenu", "-i", "-show-icons", "-p", "wallpaper",
                        "-theme", str(RICE / "rofi" / "picker.rasi")], input=lines, stdout=subprocess.PIPE, text=True)
    choice = p.stdout.strip()
    if choice:
        for pic in pics:
            if f"{pic.parent.name}/{pic.name}" == choice:
                apply(pic)
                return


def cputemp():
    """Hottest CPU sensor for conky (coretemp/k10temp), or nothing."""
    best = None
    for h in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if (h / "name").read_text().strip() not in ("coretemp", "k10temp", "zenpower"):
                continue
            for t in h.glob("temp*_input"):
                v = int(t.read_text()) / 1000
                best = v if best is None else max(best, v)
        except (OSError, ValueError):
            continue
    print(f"{best:.0f}°C" if best is not None else "")


def timer(action):
    sh("systemctl", "--user", action, "chiron-rice-rotate.timer")


def set_pause(paused):
    state = load_state()
    if paused and not state.get("paused"):
        state["compositing_before_pause"] = compositing()
        timer("stop")
        xfconf("xfwm4", "/general/use_compositing", False, "bool")
    elif not paused and state.get("paused"):
        xfconf("xfwm4", "/general/use_compositing", state.get("compositing_before_pause", True), "bool")
        if state.get("mode", "personal") == "personal":  # rotation follows the mode, which may have changed meanwhile
            timer("start")
    state["paused"] = paused
    save_state(state)
    print("paused: rotation and compositor off" if paused else "resumed")


def software_rendering():
    rc, out = sh("glxinfo", "-B")
    rc2, virt = sh("systemd-detect-virt")
    return "llvmpipe" in out or "softpipe" in out or (rc2 == 0 and virt.strip() not in ("", "none"))


# ---------------------------------------------------------------- one-time user setup

def install_user():
    layout = load_layout()
    # Look and feel
    for prop, val in (("/Net/ThemeName", GTK_THEME), ("/Net/IconThemeName", ICON_THEME),
                      ("/Gtk/CursorThemeName", "Bibata-Modern-Classic"), ("/Gtk/FontName", "Noto Sans 10"),
                      ("/Gtk/MonospaceFontName", "JetBrainsMono Nerd Font 10")):
        xfconf("xsettings", prop, val)
    xfconf("xfwm4", "/general/theme", "Default")
    xfconf("xfwm4", "/general/show_frame_shadow", True, "bool")
    xfconf("xfwm4", "/general/frame_opacity", 100, "int")
    xfconf("xfce4-terminal", "/font-name", "JetBrainsMono Nerd Font 11")
    xfconf("xfce4-terminal", "/misc-menubar-default", False, "bool")
    xfconf("xfce4-desktop", "/desktop-icons/style", 0, "int")  # clean desktop, like the reference look
    xfconf_array("xfwm4", "/general/workspace_names", ["1", "2", "3", "4"], "string")
    # Keyboard shortcuts
    me = str(RICE / "chiron-rice")
    for key, cmd in (("<Super>w", f"{me} pick"), ("<Super><Shift>w", f"{me} random"),
                     ("<Super>Return", "xfce4-terminal"), ("<Super>d", "rofi -show drun")):
        xfconf("xfce4-keyboard-shortcuts", f"/commands/custom/{key}", cmd)
    # Panels: rebuild from panel-layout.json
    sh("xfce4-panel", "--quit")
    sh("xfconf-query", "-c", "xfce4-panel", "-p", "/", "-R", "-r")
    panel_root = HOME / ".config/xfce4/panel"
    shutil.rmtree(panel_root, ignore_errors=True)
    pid, panel_ids = 0, []
    for n, panel in enumerate(layout["panels"], 1):
        panel_ids.append(n)
        ids = []
        base = f"/panels/panel-{n}"
        for k, v, kind in (("position", panel["position"], "string"), ("size", panel["size"], "uint"),
                           ("length", panel["length"], "uint"), ("position-locked", True, "bool"),
                           ("length-adjust", True, "bool"), ("icon-size", panel.get("icon_size", 0), "uint"),
                           ("autohide-behavior", panel.get("autohide", 0), "uint"), ("background-style", 0, "uint"),
                           ("nrows", 1, "uint"), ("mode", 0, "uint")):
            xfconf("xfce4-panel", f"{base}/{k}", v, kind)
        for item in panel["items"]:
            for plugin in (["separator:expand"] if item == "expand" else item):
                pid += 1
                ids.append(pid)
                kind, _, arg = plugin.partition(":")
                pp = f"/plugins/plugin-{pid}"
                xfconf("xfce4-panel", pp, kind)
                if kind == "separator":
                    xfconf("xfce4-panel", f"{pp}/expand", True, "bool")
                    xfconf("xfce4-panel", f"{pp}/style", 0, "uint")
                elif kind == "launcher":
                    l = layout["launchers"][arg]
                    d = panel_root / f"launcher-{pid}"
                    d.mkdir(parents=True, exist_ok=True)
                    (d / f"chiron-{arg}.desktop").write_text(
                        "[Desktop Entry]\nVersion=1.0\nType=Application\n" +
                        "".join(f"{k}={v.replace('{HOME}', str(HOME))}\n" for k, v in l.items()) +
                        "Terminal=false\nStartupNotify=true\n")
                    xfconf_array("xfce4-panel", f"{pp}/items", [f"chiron-{arg}.desktop"], "string")
                elif kind == "pager":
                    xfconf("xfce4-panel", f"{pp}/rows", 1, "uint")
                    xfconf("xfce4-panel", f"{pp}/miniature-view", False, "bool")
                elif kind == "clock":
                    xfconf("xfce4-panel", f"{pp}/digital-layout", 3, "uint")
                    xfconf("xfce4-panel", f"{pp}/digital-time-format", "%H:%M")
                elif kind == "whiskermenu":
                    xfconf("xfce4-panel", f"{pp}/button-icon", "view-app-grid-symbolic")
                elif kind == "systemload":  # settings live in xfconf as /<monitor>/<setting> (systemload 1.3)
                    for k, v, t in (("cpu/enabled", True, "bool"), ("cpu/use-label", True, "bool"), ("cpu/label", "cpu", "string"),
                                    ("memory/enabled", True, "bool"), ("memory/use-label", True, "bool"), ("memory/label", "mem", "string"),
                                    ("network/enabled", True, "bool"), ("network/use-label", True, "bool"), ("network/label", "net", "string"),
                                    ("swap/enabled", False, "bool"), ("uptime/enabled", False, "bool")):
                        xfconf("xfce4-panel", f"{pp}/{k}", v, t)
                elif kind == "windowck-plugin":  # settings live in an rc file; show every window's title
                    (panel_root / f"windowck-plugin-{pid}.rc").write_text(
                        "only_maximized=false\nshow_on_desktop=false\nfull_name=true\ntwo_lines=false\nshow_tooltips=true\n"
                        "size_mode=2\ntitle_size=60\nsync_wm_font=false\ntitle_font=Noto Sans 10\nsubtitle_font=Noto Sans 9\n"
                        "title_alignment=5\ntitle_padding=6\ninactive_text_alpha=60\ninactive_text_shade=110\n")
        xfconf_array("xfce4-panel", f"{base}/plugin-ids", ids, "int")
    xfconf_array("xfce4-panel", "/panels", panel_ids, "int")
    subprocess.Popen(["xfce4-panel"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    # Static configs (rofi, btop, bash). wallust needs none (run_wallust passes everything), and its
    # cache from earlier versions only takes space.
    for src, dst in ((RICE / "rofi" / "config.rasi", HOME / ".config/rofi/config.rasi"),):
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
    shutil.rmtree(HOME / ".cache/wallust", ignore_errors=True)
    btop = HOME / ".config/btop/btop.conf"
    btop.parent.mkdir(parents=True, exist_ok=True)
    text = btop.read_text() if btop.exists() else ""
    lines = [l for l in text.splitlines() if not l.startswith(("color_theme", "theme_background"))]
    btop.write_text("\n".join(lines + ['color_theme = "chiron"', "theme_background = False"]) + "\n")
    bashrc = HOME / ".bashrc"
    block = ("\n# >>> chiron-rice >>>\n"
             "command -v starship >/dev/null && eval \"$(starship init bash)\"\n"
             "[ -n \"$PS1\" ] && command -v fastfetch >/dev/null && [ -z \"$CHIRON_NO_FETCH\" ] && fastfetch\n"
             "# <<< chiron-rice <<<\n")
    text = bashrc.read_text() if bashrc.exists() else ""
    if "# >>> chiron-rice >>>" not in text:
        bashrc.write_text(text + block)
    # Autostart and rotation timer
    auto = HOME / ".config/autostart"
    auto.mkdir(parents=True, exist_ok=True)
    (auto / "chiron-rice.desktop").write_text(
        "[Desktop Entry]\nType=Application\nName=Chiron desktop theme\nExec=/opt/chiron/rice/chiron-rice login\n"
        "X-GNOME-Autostart-enabled=true\nNoDisplay=true\n")
    units = HOME / ".config/systemd/user"
    units.mkdir(parents=True, exist_ok=True)
    (units / "chiron-rice-rotate.service").write_text(
        "[Unit]\nDescription=Chiron Stick: next wallpaper\n\n[Service]\nType=oneshot\n"
        "ExecStart=/opt/chiron/rice/chiron-rice next\n")
    (units / "chiron-rice-rotate.timer").write_text(
        "[Unit]\nDescription=Chiron Stick: change the wallpaper every 30 minutes\n\n[Timer]\n"
        "OnActiveSec=30min\nOnUnitActiveSec=30min\n\n[Install]\nWantedBy=timers.target\n")
    (units / "chiron-conky.service").write_text(  # started by login(), not enabled
        "[Unit]\nDescription=Chiron Stick: system stats on the desktop (conky)\n\n[Service]\n"
        f"ExecStart={shutil.which('conky') or '/usr/bin/conky'} -c %h/.config/conky/chiron.conf\n"
        "Restart=on-failure\nRestartSec=3\n")
    sh("systemctl", "--user", "daemon-reload")
    sh("systemctl", "--user", "enable", "--now", "chiron-rice-rotate.timer")
    state = load_state()
    first = state.get("wallpaper")
    if not first or not Path(first).exists():
        pics = wallpapers(state.get("mode", "personal"))
        first = random.choice(pics) if pics else None
    if first:
        apply(first)
    login()  # after the first apply: that's what writes the conky config login() starts conky with
    print("Desktop set up. Super+W picks a wallpaper; `chiron walls update` downloads the collection.")


def restart_conky():
    """conky runs as a user service: reloading it with a signal can make it abort on an X error, and a
    conky started from the rotation timer would be stopped together with the timer's job."""
    if shutil.which("conky") and (HOME / ".config/conky/chiron.conf").exists():
        sh("systemctl", "--user", "reset-failed", "chiron-conky.service")
        sh("systemctl", "--user", "--no-block", "restart", "chiron-conky.service")  # don't wait: it takes ~1.5 s


def login():
    """Session start. A pause only lasts for a test, so one left over from a crash or reboot ends here.
    No compositor on software rendering (VMs, missing GPU drivers): it would be slow. The theme is made
    for one or the other (see-through panel and conky or not), so it's redone when that changed."""
    sh("systemctl", "--user", "import-environment", "DISPLAY", "XAUTHORITY")  # for chiron-conky.service
    state = load_state()
    if state.get("paused"):
        state["paused"] = False
        save_state(state)
    timer("start" if state.get("mode", "personal") == "personal" else "stop")
    composite = not software_rendering()
    xfconf("xfwm4", "/general/use_compositing", composite, "bool")
    wall = state.get("wallpaper")
    if wall and Path(wall).is_file() and state.get("solid") != (not composite):
        apply(wall, quiet=True)  # restarts conky too
    else:
        restart_conky()


# ---------------------------------------------------------------- command line

def main(argv):
    session_env()
    cmd = argv[0] if argv else "status"
    state = load_state()
    if cmd == "apply" and len(argv) == 2:
        apply(argv[1], transition="random")
    elif cmd == "pick":
        pick()
    elif cmd == "random":
        apply(random.choice(wallpapers(state.get("mode", "personal"))), transition="random")
    elif cmd == "next":
        if state.get("mode", "personal") == "personal" and not state.get("paused"):
            apply(random.choice(wallpapers("personal")), quiet=True, transition="random")
    elif cmd == "mode" and len(argv) == 2 and argv[1] in ("client", "personal"):
        state["mode"] = argv[1]
        save_state(state)
        timer("start" if argv[1] == "personal" and not state.get("paused") else "stop")
        apply(random.choice(wallpapers(argv[1])), transition="random")
        print(f"mode: {argv[1]}" + (" (calm wallpapers, no rotation)" if argv[1] == "client" else ""))
    elif cmd in ("pause", "resume"):
        set_pause(cmd == "pause")
    elif cmd == "animations" and len(argv) == 2 and argv[1] in ("on", "off"):
        state["animations"] = argv[1] == "on"
        save_state(state)
        print(f"animations: {argv[1]}")
    elif cmd == "login":
        login()
    elif cmd == "thumbs":
        n = build_thumbs(wallpapers(state.get("mode", "personal")))
        print(f"{n} new thumbnails")
    elif cmd == "cputemp":
        cputemp()
    elif cmd == "install-user":
        install_user()
    elif cmd == "status":
        print(json.dumps(state, indent=1))
    else:
        print(__doc__)
        return 2
    finish_transitions()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
