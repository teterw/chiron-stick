# Papirus folder colours and their approximate RGB, to pick the one nearest the accent
PAPIRUS = {"blue": "#5294e2", "bluegrey": "#607d8b", "brown": "#ae8e6c", "cyan": "#00bcd4", "darkcyan": "#45abb7",
           "deeporange": "#eb6637", "green": "#87b158", "grey": "#8e8e8e", "indigo": "#5c6bc0", "magenta": "#ca71df",
           "orange": "#ee923a", "pink": "#f06292", "red": "#e25252", "teal": "#16a085", "violet": "#7e57c2",
           "yellow": "#f9bd30", "palebrown": "#d1bfae", "paleorange": "#eecaab", "carmine": "#a30002", "nordic": "#81a1c1"}


def papirus_color(accent):
    base = Path("/usr/share/icons/Papirus/48x48/places")
    have = {n for n in PAPIRUS if (base / f"folder-{n}.svg").exists()}
    h1, l1, s1 = colorsys.rgb_to_hls(*accent)

    def dist(name):
        h2, l2, s2 = colorsys.rgb_to_hls(*hex2rgb(PAPIRUS[name]))
        dh = min(abs(h1 - h2), 1 - abs(h1 - h2))
        return dh * 3 + abs(l1 - l2) + abs(s1 - s2) * (1.5 if s1 < 0.2 else 0.5)
    return min(have or {"blue"}, key=dist)


def papirus_overlay(color):
    """Per-user icon theme that inherits Papirus-Dark and only re-points the folder icons to `color`
    (what papirus-folders does, without root and without touching the system theme)."""
    src = Path("/usr/share/icons/Papirus")
    dst = HOME / ".local" / "share" / "icons" / ICON_THEME
    if not src.is_dir():
        return
    dirs = []
    sizes = [p for p in src.iterdir() if p.is_dir() and (p / "places").is_dir()
             and (p.name == "symbolic" or (p.name[0].isdigit() and "@" not in p.name))]
    for size_dir in sorted(sizes):
        out = dst / size_dir.name / "places"
        shutil.rmtree(out, ignore_errors=True)
        out.mkdir(parents=True, exist_ok=True)
        for link in (size_dir / "places").iterdir():
            if not link.is_symlink():
                continue
            # Follow the whole chain (folder-videos -> folder-blue-videos, some via a second link)
            target = Path(os.path.realpath(link)).name
            if "-blue" in target:  # Papirus' default folder colour
                new = size_dir / "places" / target.replace("-blue", f"-{color}")
                if new.exists():
                    (out / link.name).symlink_to(new)
        dirs.append(f"{size_dir.name}/places")
    write_atomic(dst / "index.theme", "[Icon Theme]\nName=Papirus-Chiron\nComment=Papirus-Dark with folders in the wallpaper's colour\n"
                 # Papirus-Dark is complete on its own: also inheriting Papirus would make every GTK
                 # program index that theme too
                 "Inherits=Papirus-Dark,hicolor\n" f"Directories={','.join(dirs)}\n\n" +
                 "".join(f"[{d}]\nContext=Places\nSize={int(d.split('x')[0]) if d[0].isdigit() else 48}\nType=Fixed\n\n"
                         if d[0].isdigit() else f"[{d}]\nContext=Places\nSize=48\nType=Scalable\nMinSize=8\nMaxSize=512\n\n"
                         for d in dirs))
    sh("gtk-update-icon-cache", "-f", "-q", str(dst))


# ---------------------------------------------------------------- panel layout

def load_layout():
    return json.loads((RICE / "panel-layout.json").read_text())


def islands(layout):
    """Plugin ids are given in order across all panels, so setup and CSS agree without lookups."""
    out, pid = [], 0
    for panel in layout["panels"]:
        for item in panel["items"]:
            if item == "expand":
                pid += 1
                continue
            widgets = []
            for plugin in item:
                pid += 1
                kind = plugin.split(":")[0]
                widgets.append(f"{kind}-{pid}")
            out.append({"panel": panel["name"], "widgets": widgets})
    return out


# ---------------------------------------------------------------- applying

def compositing():
    return xfconf_get("xfwm4", "/general/use_compositing") == "true"


def set_wallpaper(img):
    rc, out = sh("xfconf-query", "-c", "xfce4-desktop", "-l")
    props = [p for p in out.split() if p.endswith("/last-image")] if rc == 0 else []
    if not props:
        rc, mons = sh("xrandr", "--listmonitors")
        names = [l.split()[-1] for l in mons.splitlines()[1:]] if rc == 0 else ["Virtual-1"]
        props = [f"/backdrop/screen0/monitor{n}/workspace{w}/last-image" for n in names for w in range(4)]
    for p in props:
        xfconf("xfce4-desktop", p, str(img))
        xfconf("xfce4-desktop", p.replace("last-image", "image-style"), 5, "int")  # zoomed


def cache_file(img, kind):
    """Per-image cache file in ~/.cache/chiron/<kind>/ (a changed image gets a new one)."""
    st = Path(img).stat()
    return CACHE / kind / (hashlib.sha1(f"{img}|{st.st_size}|{int(st.st_mtime)}".encode()).hexdigest() + ".json")


def run_wallust(img):
    """The wallpaper's 16 colours. wallust just prints them (no config, no templates) and keeps no
    cache: its own cache takes megabytes per image and would grow with every wallpaper. Ours keeps
    the 16 colours per image (the picker previews them too, so preview and result always match)."""
    img = Path(img)
    cache = cache_file(img, "palettes")
    try:
        return json.loads(cache.read_text())
    except (OSError, ValueError):
        pass
    try:  # not sh(): wallust explains failures on stderr
        p = subprocess.run(["wallust", "run", "-N", "-s", "-T", "-n", "-q", "-b", "fastresize", "-c", "salience",
                            "-p", "saliencedark", "-k", "--print-scheme", str(img)], capture_output=True, text=True, timeout=60)
        rc, why = p.returncode, (p.stderr.strip() or "no output").splitlines()[0]
        hexes = [l.strip() for l in p.stdout.splitlines() if l.strip().startswith("#")]
    except (OSError, subprocess.TimeoutExpired) as e:
        rc, why, hexes = 1, str(e), []
    if rc != 0 or len(hexes) < 16:
        raise SystemExit(f"chiron-rice: wallust couldn't read colours from {img}: {why}")
    palette = {f"color{i}": h for i, h in enumerate(hexes[:16])}
    palette.update(background=hexes[0], foreground=hexes[15], cursor=hexes[7])
    write_atomic(cache, json.dumps(palette))
    return palette


def bright_backdrop(img):
    """The colour of the wallpaper's bright parts (95th percentile of brightness): the worst that can
    show through the see-through terminal. A bright sky counts, a few stars don't."""
    cache = cache_file(img, "backdrops")
    try:
        return tuple(json.loads(cache.read_text()))
    except (OSError, ValueError):
        pass
    from PIL import Image
    with Image.open(img) as im:
        im.draft("RGB", (192, 108))
        px = [tuple(x / 255 for x in p) for p in im.convert("RGB").resize((96, 54), Image.BILINEAR).getdata()]
    c = sorted(px, key=luminance)[int(len(px) * 0.95)]
    write_atomic(cache, json.dumps(c))
    return c


def terminal_settings(c, img, solid):
    """xfce4-terminal: the wallpaper's colours; see-through like Ptyxis when there's a compositor
    (without one it can't be, and the solid colours need no adjusting). [(property, value, type)]"""
    if solid:
        t, mode = {"fg": c["fg"], "term": c["term"], "alpha": 1.0}, "TERMINAL_BACKGROUND_SOLID"
    else:
        t, mode = terminal_colours(c, bright_backdrop(img)), "TERMINAL_BACKGROUND_TRANSPARENT"
    return [("/color-use-theme", False, "bool"), ("/color-foreground", rgb2hex(t["fg"]), "string"),
            ("/color-background", rgb2hex(c["bg"]), "string"), ("/color-cursor", rgb2hex(c["accent"]), "string"),
            ("/color-palette", ";".join(rgb2hex(x) for x in t["term"]), "string"),
            ("/background-mode", mode, "string"), ("/background-darkness", t["alpha"], "double")]


def gtk_theme_files(c, layout, solid):
    """GTK3 programs read ~/.config/gtk-3.0/gtk.css only at startup, but re-read a *theme* whenever the
    theme changes. So the colours live in a generated theme kept in two copies, Chiron-a and Chiron-b:
    write the one not in use, then switch to it, and every running program restyles at once.
    Returns the theme name and its files ({path: text})."""
    current = xfconf_get("xsettings", "/Net/ThemeName")
    name = "Chiron-b" if current == "Chiron-a" else "Chiron-a"
    root = HOME / ".local/share/themes" / name
    base = Path("/usr/share/themes") / GTK_THEME
    files = {}
    for ver, lay in (("gtk-3.0", layout), ("gtk-4.0", {"panels": []})):
        imp = f'@import url("file://{base / ver / "gtk.css"}");\n' if (base / ver / "gtk.css").exists() else ""
        files[root / ver / "gtk.css"] = imp + gtk_css(c, lay, solid)
    files[root / "index.theme"] = ("[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Chiron\n"
                                   "Comment=Clinic Night: adw-gtk3-dark coloured from the wallpaper (chiron-rice)\n"
                                   f"Encoding=UTF-8\n\n[X-GNOME-Metatheme]\nGtkTheme={name}\n")
    return name, files


def dock_backdrop(img, layout, solid):
    """The dock is a rounded pill floating on the wallpaper. Without a compositor nothing can be
    see-through, so its corners would sit on a dark rectangle: then the dock's background becomes the
    exact slice of wallpaper behind it (fake transparency, as panels did before compositors)."""
    names = [p.get("name") for p in layout["panels"]]
    if "dock" not in names:
        return
    n, size = names.index("dock") + 1, layout["panels"][names.index("dock")]["size"]
    prop = f"/panels/panel-{n}"
    if not solid:
        xfconf("xfce4-panel", f"{prop}/background-style", 0, "uint")
        return
    geo, last = None, None
    for _ in range(10):  # right after a theme switch the panel is still re-laying itself out
        rc, out = sh("xdotool", "search", "--onlyvisible", "--class", "xfce4-panel")
        found = None
        for wid in out.split() if rc == 0 else []:
            g = dict(l.split("=", 1) for l in sh("xdotool", "getwindowgeometry", "--shell", wid)[1].split() if "=" in l)
            x, w, h = int(g.get("X", -1)), int(g.get("WIDTH", 0)), int(g.get("HEIGHT", 0))
            if x >= 0 and w > size and size <= h <= size + 2:  # the panel adds a 1 px border
                found = (x, w, h)
        if found and found == last:  # the same twice in a row: settled
            geo = found
            break
        last = found
        time.sleep(0.2)
    rc, mons = sh("xrandr", "--listmonitors")
    mon = None
    for m in re.finditer(r"(\d+)/\d+x(\d+)/\d+\+(\d+)\+(\d+)", mons if rc == 0 else ""):
        mw, mh, mx, my = map(int, m.groups())
        if geo and mx <= geo[0] < mx + mw:
            mon = (mw, mh, mx)
    if not geo or not mon:
        return
    from PIL import Image, ImageOps
    mw, mh, mx = mon
    with Image.open(img) as im:
        im.draft("RGB", (mw, mh))
        full = ImageOps.fit(im.convert("RGB"), (mw, mh), Image.BILINEAR)  # as xfdesktop's "zoomed" shows it
    x0 = geo[0] - mx
    current = xfconf_get("xfce4-panel", f"{prop}/background-image") or ""
    path = CACHE / ("dock-b.png" if current.endswith("dock-a.png") else "dock-a.png")  # a new name: the panel reloads it
    path.parent.mkdir(parents=True, exist_ok=True)
    full.crop((x0, mh - geo[2], x0 + geo[1], mh)).save(path)
    xfconf("xfce4-panel", f"{prop}/background-image", str(path))
    xfconf("xfce4-panel", f"{prop}/background-style", 2, "uint")


def apply(img, quiet=False, transition=None):
    """transition: animate the change behind the windows (chiron-walls effect name, or "random")."""
    img = Path(img).expanduser().resolve()
    if not img.is_file() or img.suffix.lower() not in IMAGE_EXT:
        raise SystemExit(f"chiron-rice: not an image: {img}")
    old = load_state().get("wallpaper")
    # Work out everything before changing anything: if wallust or any step here fails, the old theme
    # stays whole instead of the desktop ending up half-themed.
    palette = run_wallust(img)
    c = derive(palette)
    layout = load_layout()
    solid = not compositing()
    theme, files = gtk_theme_files(c, layout, solid)
    term = terminal_settings(c, img, solid)
    files.update({
        # Personal gtk.css would override the theme with stale colours until a restart, so keep it empty;
        # GTK4/libadwaita apps don't use GTK themes, so they get the colours there (read when they start).
        HOME / ".config/gtk-3.0/gtk.css": "/* Chiron colours live in ~/.local/share/themes/Chiron-a|b (chiron-rice) */\n",
        HOME / ".config/gtk-4.0/gtk.css": gtk_css(c, {"panels": []}, solid),
        HOME / ".config/rofi/chiron-colors.rasi": rofi_colors(c),
        HOME / ".config/btop/themes/chiron.theme": btop_theme(c),
        HOME / ".config/conky/chiron.conf": conky_conf(c, argb=not solid),
        HOME / ".config/starship.toml": starship_toml(c),
        HOME / ".config/fastfetch/config.jsonc": fastfetch_jsonc(c),
    })
    folders = papirus_color(c["accent"])
    for path, text in files.items():
        write_atomic(path, text)
    if transition and start_transition(old, img, transition):
        time.sleep(0.7)  # let the new wallpaper sweep in halfway, then recolour everything with it
    for prop, value, kind in term:
        xfconf("xfce4-terminal", prop, value, kind)
    papirus_overlay(folders)
    # systemload graph bars in the accent colour (GdkRGBA is stored as 4 doubles in xfconf)
    r, g, b = c["accent"]
    for island in islands(layout):
        for w in island["widgets"]:
            if w.startswith("systemload-"):
                for k in ("cpu/color", "memory/color", "network/color", "swap/color"):
                    sh("xfconf-query", "-c", "xfce4-panel", "-p", f"/plugins/plugin-{w.split('-')[-1]}/{k}", "-n", "-a",
                       "-t", "double", "-s", f"{r:.3f}", "-t", "double", "-s", f"{g:.3f}",
                       "-t", "double", "-s", f"{b:.3f}", "-t", "double", "-s", "1.0")
    set_wallpaper(img)
    xfconf("xsettings", "/Net/ThemeName", theme)  # switching to the freshly written theme restyles everything
    xfconf("xsettings", "/Net/IconThemeName", "Papirus-Dark")  # same trick for the folder colours; the pause
    time.sleep(0.4)                                            # lets programs see two separate changes
    xfconf("xsettings", "/Net/IconThemeName", ICON_THEME)
    dock_backdrop(img, layout, solid)  # after the theme switch: the dock's size depends on it
    restart_conky()
    state = load_state()
    state["wallpaper"] = str(img)
    state["solid"] = solid  # login() redoes the theme when the compositor setting changes
    save_state(state)
    if not quiet:
        print(f"applied {img.name}: accent {rgb2hex(c['accent'])}, background {rgb2hex(c['bg'])}")


TRANSITIONS = []  # running chiron-walls transition processes


def start_transition(old, new, effect="random"):
    """swww-style animated wallpaper change behind the windows (chiron-walls transition). Returns once
    the animation covers the desktop, so the switch underneath stays hidden. Skipped when animations
    are off, during a test pause, or without an old wallpaper to animate from."""
    state = load_state()
    if (state.get("paused") or not state.get("animations", True) or not old or not Path(old).is_file()
            or Path(old) == Path(new) or not os.environ.get("DISPLAY")):
        return False
    try:
        p = subprocess.Popen([str(RICE / "chiron-walls"), "transition", str(old), str(new), effect],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return False
    ready, _, _ = select.select([p.stdout], [], [], 4.0)
    if not ready or p.stdout.readline().strip() != "ready":
        p.kill()  # never leave a stuck animation over the desktop
        return False
    TRANSITIONS.append(p)
    return True


def finish_transitions():
    """Wait for running animations: a timer job's processes end with the job."""
    for p in TRANSITIONS:
        try:
            p.wait(timeout=8)
        except subprocess.TimeoutExpired:
            p.kill()


def pick():
    """The full-screen picker (chiron-walls); rofi if GTK can't start."""
    rc = subprocess.call([str(RICE / "chiron-walls"), "pick"])
    if rc == 3:
        pick_rofi()


def pick_rofi():
    state = load_state()
    pics = wallpapers(state.get("mode", "personal"))
    new = build_thumbs(pics, quiet=True)
    if new:
        sh("notify-send", "Chiron", f"Made {new} new wallpaper thumbnails")
    lines = "".join(f"{p.parent.name}/{p.name}\0icon\x1f{thumb_path(p)}\n" for p in pics)
    # stderr is not captured: if rofi cannot open (e.g. it fails to grab the keyboard), its error
    # reaches the terminal or ~/.xsession-errors instead of vanishing.
    p = subprocess.run(["rofi", "-dmenu", "-i", "-show-icons", "-p", "wallpaper",
                        "-theme", str(RICE / "rofi" / "picker.rasi")], input=lines, stdout=subprocess.PIPE, text=True)
    choice = p.stdout.strip()
    if choice:
        for pic in pics:
            if f"{pic.parent.name}/{pic.name}" == choice:
                apply(pic)
                return


def cputemp():
    """Hottest CPU sensor for conky (coretemp/k10temp), or nothing."""
    best = None
    for h in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if (h / "name").read_text().strip() not in ("coretemp", "k10temp", "zenpower"):
                continue
            for t in h.glob("temp*_input"):
                v = int(t.read_text()) / 1000
                best = v if best is None else max(best, v)
        except (OSError, ValueError):
            continue
    print(f"{best:.0f}°C" if best is not None else "")


def timer(action):
    sh("systemctl", "--user", action, "chiron-rice-rotate.timer")


def set_pause(paused):
    state = load_state()
    if paused and not state.get("paused"):
        state["compositing_before_pause"] = compositing()
        timer("stop")
        xfconf("xfwm4", "/general/use_compositing", False, "bool")
    elif not paused and state.get("paused"):
        xfconf("xfwm4", "/general/use_compositing", state.get("compositing_before_pause", True), "bool")
        if state.get("mode", "personal") == "personal":  # rotation follows the mode, which may have changed meanwhile
            timer("start")
    state["paused"] = paused
    save_state(state)
    print("paused: rotation and compositor off" if paused else "resumed")


def software_rendering():
    rc, out = sh("glxinfo", "-B")
    rc2, virt = sh("systemd-detect-virt")
    return "llvmpipe" in out or "softpipe" in out or (rc2 == 0 and virt.strip() not in ("", "none"))


