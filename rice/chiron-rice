RICE = Path(__file__).resolve().parent
HOME = Path.home()
WALLS = HOME / "Pictures" / "walls"
CACHE = HOME / ".cache" / "chiron"
STATE = HOME / ".config" / "chiron" / "rice.json"
FALLBACK_WALLS = Path("/usr/share/backgrounds")  # works offline until `chiron walls update` ran
IMAGE_EXT = {".jpg", ".jpeg", ".png", ".webp"}
GTK_THEME = "adw-gtk3-dark"
ICON_THEME = "Papirus-Chiron"


# ---------------------------------------------------------------- environment / small helpers

def session_env():
    """Make xfconf/X tools work from timers, autostart and sudo-launched calls too."""
    uid = os.getuid()
    os.environ.setdefault("DISPLAY", ":0")
    os.environ.setdefault("XAUTHORITY", str(HOME / ".Xauthority"))
    os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{uid}/bus")
    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")


def sh(*cmd, check=False, timeout=60, **kw):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except (OSError, subprocess.TimeoutExpired) as e:
        if check:
            raise SystemExit(f"chiron-rice: {cmd[0]} failed: {e}")
        return 1, ""
    if check and p.returncode != 0:
        raise SystemExit(f"chiron-rice: {' '.join(cmd)} failed: {(p.stderr or p.stdout).strip()[-300:]}")
    return p.returncode, p.stdout


def xfconf(channel, prop, value, kind="string"):
    """Set (creating if needed) one xfconf property. kind: string/int/bool/uint/double."""
    if isinstance(value, bool):
        value = "true" if value else "false"
    sh("xfconf-query", "-c", channel, "-p", prop, "-n", "-t", kind, "-s", str(value))


def xfconf_array(channel, prop, values, kind="int"):
    args = []
    for v in values:
        args += ["-t", kind, "-s", str(v)]
    sh("xfconf-query", "-c", channel, "-p", prop, "-n", "-a", *args)


def xfconf_get(channel, prop):
    rc, out = sh("xfconf-query", "-c", channel, "-p", prop)
    return out.strip() if rc == 0 else None


def write_atomic(path, text):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {"mode": "personal", "paused": False}


def save_state(state):
    write_atomic(STATE, json.dumps(state, indent=1) + "\n")


# ---------------------------------------------------------------- colours

def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def rgb2hex(c):
    return "#" + "".join(f"{round(max(0, min(1, x)) * 255):02x}" for x in c)


def luminance(c):
    def lin(x):
        return x / 12.92 if x <= 0.03928 else ((x + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(x) for x in c)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def mix(a, b, t):
    return tuple(x + (y - x) * t for x, y in zip(a, b))


BLACK, WHITE = (0, 0, 0), (1, 1, 1)
BRAND = hex2rgb("#8b5cf6")  # Chiron violet: the boot branding's accent, and grey wallpapers'


def toward(c, target, other, ratio, step=0.04):
    """Move colour c toward `target` until its contrast against `other` reaches `ratio`."""
    orig, t = c, 0.0
    while contrast(c, other) < ratio and t < 1:
        t = min(1.0, t + step)
        c = mix(orig, target, t)
    return c


def derive(palette):
    """Wallust palette -> the colours the desktop uses, with readable contrast guaranteed:
    background always dark, text >= 7:1 against it, accent >= 3:1 (WCAG AAA text / UI components)."""
    bg = hex2rgb(palette["background"])
    if luminance(bg) > 0.03:
        bg = mix(bg, BLACK, 0.6)  # Clinic Night is always dark
    while luminance(bg) > 0.03:
        bg = mix(bg, BLACK, 0.2)
    fg = toward(hex2rgb(palette["foreground"]), WHITE, bg, 7.0)

    def score(h):
        c = hex2rgb(h)
        _, l, s = colorsys.rgb_to_hls(*c)
        return s * (1 - abs(l - 0.55))  # saturated, mid-light colours make good accents
    candidates = [palette.get(f"color{i}") for i in range(1, 7)] + [palette.get(f"color{i}") for i in range(9, 15)]
    candidates = [c for c in candidates if c]
    accent = hex2rgb(max(candidates, key=score)) if candidates else BRAND
    h, l, s = colorsys.rgb_to_hls(*accent)
    if s < 0.08:    # grey wallpapers have no hue to keep (it would come out red): use Chiron's violet
        accent = BRAND
    elif s < 0.25:  # low-colour wallpapers: give the accent some life without changing its hue
        accent = colorsys.hls_to_rgb(h, max(l, 0.55), 0.45)
    accent = toward(accent, WHITE, bg, 3.0)
    on_accent = BLACK if contrast(accent, BLACK) >= contrast(accent, WHITE) else WHITE
    surface = mix(bg, fg, 0.07)
    surface2 = mix(bg, fg, 0.14)
    muted = toward(mix(fg, bg, 0.45), WHITE, bg, 4.5)
    term = []
    for i in range(16):
        c = hex2rgb(palette.get(f"color{i}", "#808080"))
        if i not in (0, 8):
            c = toward(c, WHITE, bg, 4.5)  # every terminal colour readable on the background
        term.append(c)
    return {"bg": bg, "fg": fg, "accent": accent, "on_accent": on_accent, "surface": surface,
            "surface2": surface2, "muted": muted, "term": term}


TERM_ALPHA = 0.85  # the see-through terminal (with a compositor), like Tete's Ptyxis


def terminal_colours(c, bright, alpha=TERM_ALPHA):
    """Text colours for the see-through terminal. 15% of the wallpaper shows through, so its bright
    parts lighten the background: the text is lightened until it's as readable there as on the solid
    background (7:1, terminal colours 4.5:1). Only if white text can't manage it does the terminal
    get less see-through."""
    while True:
        seen = mix(bright, c["bg"], alpha)
        fg = toward(c["fg"], WHITE, seen, 7.0)
        term = [t if i in (0, 8) else toward(t, WHITE, seen, 4.5) for i, t in enumerate(c["term"])]
        if alpha >= 1.0 or (contrast(fg, seen) >= 7.0 and
                            all(contrast(t, seen) >= 4.5 for i, t in enumerate(term) if i not in (0, 8))):
            return {"fg": fg, "term": term, "alpha": round(alpha, 2)}
        alpha = min(1.0, alpha + 0.05)


# ---------------------------------------------------------------- wallpaper collections

SOURCES = RICE / "wallsources.conf"
REVIEW = HOME / ".config" / "chiron" / "walls-review.json"


def wallsources():
    """The collections in review order: {name: {"git" or "list", "branch", "paths", "about"}}."""
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.read(SOURCES, encoding="utf-8")
    return {name: dict(cfg[name]) for name in cfg.sections()}


@functools.lru_cache(maxsize=None)
def list_entries(listfile):
    """A list collection's files: [(sha256, url, file, title, credit)]."""
    out = []
    for line in (RICE / listfile).read_text(encoding="utf-8").splitlines():
        if line.strip() and not line.startswith("#"):
            sha, url, name, title, credit = (line.split("\t") + [""] * 5)[:5]
            out.append((sha, url, name, title, credit))
    return out


def wallsets():
    cfg = configparser.ConfigParser()
    cfg.read(RICE / "wallsets.conf")
    sets = {}
    for name in ("personal", "client"):
        sec = cfg[name] if name in cfg else {}
        sets[name] = {"include": (sec.get("include") or "").split(), "exclude": (sec.get("exclude") or "").split()}
    return sets


def load_review():
    """Choices from `chiron walls review`: paths relative to ~/Pictures/walls, kept or dropped."""
    try:
        d = json.loads(REVIEW.read_text())
    except (OSError, ValueError):
        d = {}
    return {"keep": set(d.get("keep", [])), "drop": set(d.get("drop", []))}


def save_review(review):
    write_atomic(REVIEW, json.dumps({k: sorted(v) for k, v in review.items()}, indent=0) + "\n")


def all_pictures():
    """Every downloaded picture that wasn't removed in the review, in review order. Folders of your
    own in ~/Pictures/walls count too, after the collections."""
    if not WALLS.is_dir():
        return []
    drop = load_review()["drop"]
    names = list(wallsources())
    own = sorted(p.name for p in WALLS.iterdir() if p.is_dir() and not p.name.startswith(".") and p.name not in names)
    out = []
    for name in names + own:
        found = []
        for dirpath, dirs, files in os.walk(WALLS / name):
            dirs[:] = [d for d in dirs if not d.startswith(".")]  # skips .git
            found += [Path(dirpath) / f for f in files if Path(f).suffix.lower() in IMAGE_EXT and not f.startswith(".")]
        out += [p for p in sorted(found) if str(p.relative_to(WALLS)) not in drop]
    return out


def wallpapers(mode):
    s = wallsets()[mode]
    inc, exc = set(s["include"]), set(s["exclude"])
    pics = []
    for p in all_pictures():
        parts = p.relative_to(WALLS).parts
        keys = {parts[0], "/".join(parts[:2])}
        if (inc and not keys & inc) or keys & exc:
            continue
        pics.append(p)
    if not pics:
        pics = [p for p in sorted(FALLBACK_WALLS.rglob("*")) if p.suffix.lower() in IMAGE_EXT]
    return pics


def describe(img):
    """(collection, folder, title, credit) to show with a picture."""
    img = Path(img)
    title = img.stem.replace("_", " ").replace("-", " ")
    try:
        parts = img.relative_to(WALLS).parts
    except ValueError:
        return img.parent.name, "", title, ""
    src = wallsources().get(parts[0], {})
    if "list" in src:
        for _sha, _url, name, t, credit in list_entries(src["list"]):
            if name == img.name:
                return parts[0], "", t, credit
    return parts[0], parts[-2] if len(parts) > 2 else "", title, ""


def git(*args, cwd=None, stdin=None):
    p = subprocess.run(["git", *args], cwd=cwd, input=stdin, capture_output=True, text=True)
    if p.returncode != 0:
        raise SystemExit(f"chiron-rice: git {args[0]} failed: {(p.stderr or p.stdout).strip()[-300:]}")
    return p.stdout


def sparse_patterns(src, drops):
    """The collection's folders, minus the pictures dropped in the review (gitignore syntax)."""
    def esc(rel):
        rel = "".join("\\" + ch if ch in "*?[\\" else ch for ch in rel)
        return rel[:-1] + "\\ " if rel.endswith(" ") else rel
    return "\n".join(src.get("paths", "/*").split() + [f"!/{esc(r)}" for r in sorted(drops)]) + "\n"


def sync_git(name, src, drops):
    """Partial clone + sparse checkout: only the collection's picture folders are downloaded, and
    dropped pictures stay out of the checkout through every update."""
    dest = WALLS / name
    branch = src.get("branch", "main")
    if not (dest / ".git").is_dir():
        shutil.rmtree(dest, ignore_errors=True)
        print(f"{name}: downloading {src['git']} …", flush=True)
        git("clone", "--quiet", "--filter=blob:none", "--no-checkout", "--depth", "1", "--branch", branch, src["git"], str(dest))
        git("sparse-checkout", "set", "--no-cone", "--stdin", cwd=dest, stdin=sparse_patterns(src, drops))
        git("checkout", "--quiet", branch, cwd=dest)
    else:
        print(f"{name}: updating …", flush=True)
        git("sparse-checkout", "set", "--no-cone", "--stdin", cwd=dest, stdin=sparse_patterns(src, drops))
        git("fetch", "--quiet", "--depth", "1", "origin", branch, cwd=dest)
        git("reset", "--quiet", "--hard", "FETCH_HEAD", cwd=dest)


def sync_list(name, src, drops):
    """Download the listed files, each checked against its SHA-256 (CLAUDE.md safety rule 7)."""
    import urllib.request
    dest = WALLS / name
    dest.mkdir(parents=True, exist_ok=True)
    entries = list_entries(src["list"])
    wanted = {f for _sha, _url, f, _t, _c in entries if f not in drops}
    fresh = 0
    for sha, url, f, title, _credit in entries:
        target = dest / f
        if f not in wanted or (target.is_file() and hashlib.sha256(target.read_bytes()).hexdigest() == sha):
            continue
        if not fresh:
            print(f"{name}: downloading {len(wanted)} pictures …", flush=True)
        fresh += 1
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "chiron-stick (chiron walls update)"})
            data = urllib.request.urlopen(req, timeout=120).read()
        except OSError as e:
            print(f"{name}: {title}: download failed ({e}), skipped")
            continue
        if hashlib.sha256(data).hexdigest() != sha:
            print(f"{name}: {title}: checksum mismatch, skipped")
            continue
        tmp = target.with_suffix(".part")
        tmp.write_bytes(data)
        tmp.replace(target)
    for p in dest.iterdir():  # no longer listed, or removed in the review
        if p.is_file() and p.name not in wanted:
            p.unlink()


def clean_caches(pics):
    """Drop thumbnails and palettes of pictures that are gone."""
    keep = {thumb_path(p).name for p in pics}
    for t in (CACHE / "thumbs").glob("*.jpg"):
        if t.name not in keep:
            t.unlink(missing_ok=True)
    keep = set()
    for p in pics:
        st = p.stat()
        keep.add(hashlib.sha1(f"{p}|{st.st_size}|{int(st.st_mtime)}".encode()).hexdigest() + ".json")
    for f in (CACHE / "palettes").glob("*.json"):
        if f.name not in keep:
            f.unlink(missing_ok=True)


def walls_update():
    """`chiron walls update`: download or update every collection in wallsources.conf."""
    WALLS.mkdir(parents=True, exist_ok=True)
    if (WALLS / ".git").is_dir():  # before 0.6.0 one collection (dharmx/walls) lived right here
        print("Removing the old wallpaper collection (dharmx/walls) …", flush=True)
        for child in list(WALLS.iterdir()):
            shutil.rmtree(child) if child.is_dir() and not child.is_symlink() else child.unlink()
    review = load_review()
    for name, src in wallsources().items():
        drops = {r[len(name) + 1:] for r in review["drop"] if r.startswith(name + "/")}
        try:
            if "git" in src:
                sync_git(name, src, drops)
            elif "list" in src:
                sync_list(name, src, drops)
        except (SystemExit, OSError) as e:  # one collection failing doesn't stop the others
            print(f"{name}: {e}")
    pics = all_pictures()
    print("Making thumbnails …", flush=True)
    build_thumbs(pics, quiet=True)
    clean_caches(pics)
    state = load_state()
    if not state.get("wallpaper") or not Path(state["wallpaper"]).is_file():
        choice = wallpapers(state.get("mode", "personal"))
        if choice:
            apply(random.choice(choice))
    walls_status()


def apply_review():
    """Take the pictures dropped in the review off the disk (from git collections through the sparse
    checkout, so updates don't bring them back), and move off a dropped current wallpaper."""
    review = load_review()
    for name, src in wallsources().items():
        dest = WALLS / name
        drops = {r[len(name) + 1:] for r in review["drop"] if r.startswith(name + "/")}
        if not dest.is_dir() or not drops:
            continue
        if "git" in src and (dest / ".git").is_dir():
            git("sparse-checkout", "set", "--no-cone", "--stdin", cwd=dest, stdin=sparse_patterns(src, drops))
        else:
            for r in drops:
                (dest / r).unlink(missing_ok=True)
    state = load_state()
    cur = state.get("wallpaper")
    if cur and not Path(cur).is_file():
        choice = wallpapers(state.get("mode", "personal"))
        if choice:
            apply(random.choice(choice), quiet=True, transition="random")


def walls_status():
    review = load_review()
    pics = all_pictures()
    total = 0
    for name, src in list(wallsources().items()) + [("(your own)", {})]:
        mine = [p for p in pics if p.relative_to(WALLS).parts[0] == name] if name != "(your own)" else \
               [p for p in pics if p.relative_to(WALLS).parts[0] not in wallsources()]
        if not mine and name == "(your own)":
            continue
        kept = sum(str(p.relative_to(WALLS)) in review["keep"] for p in mine)
        dropped = sum(r.startswith(name + "/") for r in review["drop"])
        print(f"  {name:12} {len(mine):4} pictures  {kept:4} kept  {dropped:4} removed  {src.get('about', '')}")
        total += len(mine)
    left = sum(str(p.relative_to(WALLS)) not in review["keep"] for p in pics)
    size = sh("du", "-sh", "--exclude=.git", str(WALLS))[1].split("\t")[0] if WALLS.is_dir() else "0"
    print(f"{total} wallpapers ({size}). " + (f"{left} not reviewed yet: chiron walls review" if left else "All reviewed."))


def thumb_path(img):
    return CACHE / "thumbs" / (hashlib.sha1(str(img).encode()).hexdigest() + ".jpg")


def build_thumbs(pics, quiet=False):
    from PIL import Image, ImageOps
    todo = [p for p in pics if not thumb_path(p).exists()]
    (CACHE / "thumbs").mkdir(parents=True, exist_ok=True)
    for n, p in enumerate(todo, 1):
        try:
            with Image.open(p) as im:
                ImageOps.fit(im.convert("RGB"), (320, 180)).save(thumb_path(p), quality=82)
        except Exception:  # noqa: BLE001 - a broken image just gets no thumbnail
            continue
        if not quiet and n % 100 == 0:
            print(f"thumbnails: {n}/{len(todo)}")
    return len(todo)


# ---------------------------------------------------------------- rendering

def gtk_css(c, layout, solid_panel):
    hx = {k: rgb2hex(v) for k, v in c.items() if k != "term"}
    names = {"accent_color": "accent", "accent_bg_color": "accent", "accent_fg_color": "on_accent",
             "window_bg_color": "bg", "window_fg_color": "fg", "view_bg_color": "surface", "view_fg_color": "fg",
             "headerbar_bg_color": "surface", "headerbar_fg_color": "fg", "headerbar_border_color": "accent",
             "headerbar_backdrop_color": "bg", "sidebar_bg_color": "surface", "sidebar_fg_color": "fg",
             "card_bg_color": "surface", "card_fg_color": "fg", "dialog_bg_color": "surface", "dialog_fg_color": "fg",
             "popover_bg_color": "surface2", "popover_fg_color": "fg", "theme_selected_bg_color": "accent",
             "theme_selected_fg_color": "on_accent"}
    out = ["/* Generated by chiron-rice from the current wallpaper. Edits are overwritten. */"]
    out += [f"@define-color {n} {hx[k]};" for n, k in names.items()]
    panel_bg = hx["bg"] if solid_panel else "transparent"
    out += ["", f"#XfcePanelWindow {{ background-color: {panel_bg}; }}",
            f"#XfcePanelWindow, #XfcePanelWindow label, #XfcePanelWindow button {{ color: {hx['fg']}; }}",
            f"#XfcePanelWindow button:hover {{ background-color: alpha({hx['accent']}, 0.25); }}",
            f"#XfcePanelWindow button:checked {{ background-color: {hx['accent']}; color: {hx['on_accent']}; }}"]
    # A panel plugin's own widget doesn't paint; its direct child (box or button) does, so islands are
    # drawn on "#plugin-N > *". systemload paints one level deeper (a box per graph), so its first and
    # last inner box carry the island's ends (tested on xfce4-panel 4.18).
    deeper = ("systemload",)
    for island in islands(layout):
        sel = [f"#{w} > * > *" if w.rsplit("-", 1)[0] in deeper else f"#{w} > *" for w in island["widgets"]]
        if island["panel"] == "dock":  # a floating pill with rounded ends and a thin accent outline
            edge = f"1px solid alpha({hx['accent']}, 0.55)"
            out.append(f"{', '.join(sel)} {{ background-color: alpha({hx['bg']}, 0.94); border-radius: 0; "
                       f"border-top: {edge}; border-bottom: {edge}; margin-top: 4px; margin-bottom: 4px; padding: 0 5px; }}")
            out.append(f"{', '.join(s + ':hover' for s in sel)} {{ background-color: mix({hx['bg']}, {hx['accent']}, 0.3); }}")
            out.append(f"{sel[0]} {{ border-left: {edge}; border-top-left-radius: 14px; border-bottom-left-radius: 14px; "
                       f"margin-left: 10px; padding-left: 12px; }}")
            out.append(f"{sel[-1]} {{ border-right: {edge}; border-top-right-radius: 14px; border-bottom-right-radius: 14px; "
                       f"margin-right: 10px; padding-right: 12px; }}")
            continue
        out.append(f"{', '.join(sel)} {{ background-color: {hx['surface']}; border-radius: 0; margin-top: 3px; margin-bottom: 3px; padding: 0 3px; }}")
        first, last = sel[0], sel[-1]
        if first.endswith("> * > *"):
            first += ":first-child"
        if last.endswith("> * > *"):
            last += ":last-child"
        out.append(f"{first} {{ border-left: 3px solid {hx['accent']}; border-top-left-radius: 7px; border-bottom-left-radius: 7px; margin-left: 6px; }}")
        out.append(f"{last} {{ border-right: 3px solid {hx['accent']}; border-top-right-radius: 7px; border-bottom-right-radius: 7px; }}")
    out += ["", f"#XfceNotifyWindow {{ background-color: {hx['surface']}; color: {hx['fg']}; border: 2px solid {hx['accent']}; border-radius: 6px; }}",
            f"#XfceNotifyWindow label#summary {{ color: {hx['accent']}; font-weight: bold; }}"]
    return "\n".join(out) + "\n"


def rofi_colors(c):
    hx = {k: rgb2hex(v) for k, v in c.items() if k != "term"}
    # rofi property names can't contain "_", hence on-accent
    return ("/* Generated by chiron-rice */\n* {\n" + "".join(
        f"    {k.replace('_', '-')}: {hx[k]};\n" for k in ("bg", "fg", "accent", "on_accent", "surface", "surface2", "muted")) + "}\n")


def btop_theme(c):
    hx = {k: rgb2hex(v) for k, v in c.items() if k != "term"}
